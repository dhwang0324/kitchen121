---
// One menu category: heading and notes, a plain item list on the left, and that category's photos (straight, one size) on the right.
// Categories without photos use the full width with a two-column list.
import { food } from '../data/site';
import type { Section } from '../data/menu';
interface Props { section: Section }
const { section: s } = Astro.props;
const photos = (s.photos ?? []).slice(0, s.items.length > 10 ? 3 : s.items.length > 5 ? 2 : 1);
---
<section class:list={['panel', photos.length === 0 && 'panel--plain']} id={s.id} data-panel={s.id}>
  <div class="main">
    <header class="phead">
      <h2>{s.title}</h2>
      {s.note && <p class="note">{s.note}</p>}
      {s.extra && <p class="extra">{s.extra}</p>}
    </header>
    <ul class="list">
      {s.items.map((i) => (
        <li>
          <div class="row">
            <span class="n">{i.n}{i.raw && <span class="raw" title="Served undercooked or may contain raw ingredient">*</span>}{i.spicy && <span class="mark spicy">Spicy</span>}{i.v && <span class="mark" title="Marked V on our printed menu">V</span>}{i.g && <span class="mark" title="Marked G on our printed menu">G</span>}</span>
            <b>${i.p}</b>
          </div>
          {(i.d || i.serves) && <p class="d">{i.serves && <span class="serves">{i.serves}{i.d && '. '}</span>}{i.d}</p>}
        </li>
      ))}
    </ul>
  </div>
  {photos.length > 0 && (
    <div class="photos">
      {photos.map((p) => { const im = food(p.img); return (
        <figure><img src={im.src} alt={p.cap} width={im.width} height={im.height} loading="lazy" /><figcaption>{p.cap}</figcaption></figure>
      ); })}
    </div>
  )}
</section>

<style>
  .panel { background: #fff; color: var(--ink); border-radius: 30px; padding: clamp(22px, 4vw, 56px); box-shadow: 0 10px 40px rgb(0 0 0 / .06); display: grid; grid-template-columns: 7fr 5fr; gap: clamp(1.5rem, 4vw, 4rem); align-items: start; }
  .panel--plain { grid-template-columns: 1fr; }
  .panel[hidden] { display: none; }
  h2 { font-size: clamp(2.4rem, 5vw, 3.8rem); }
  .note { margin: .8rem 0 0; font-size: .95rem; color: #5f5f5f; }
  .extra { margin: .5rem 0 0; font-size: .9rem; font-weight: 600; color: var(--green); }
  .list { list-style: none; margin: clamp(1.2rem, 2.5vw, 2rem) 0 0; padding: 0; }
  .list li { padding: .85rem 0; border-top: 1px solid rgb(0 0 0 / .09); }
  .list li:last-child { border-bottom: 1px solid rgb(0 0 0 / .09); }
  .panel--plain .list { columns: 2; column-gap: clamp(2rem, 5vw, 4.5rem); }
  .panel--plain .list li { break-inside: avoid; }
  .row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .n { font-weight: 600; font-size: 1.03rem; line-height: 1.3; }
  .raw { color: var(--green); margin-left: 1px; }
  .row b { font-family: var(--display); font-weight: 800; font-size: 1.5rem; line-height: 1; color: var(--green); }
  .d { margin: .2rem 0 0; padding-right: 3rem; font-size: .9rem; line-height: 1.45; color: #6b6b6b; }
  .serves { font-weight: 600; color: #444; }
  .mark { display: inline-block; margin-left: .4rem; padding: 0 .32rem; border: 1px solid #b9b9b9; border-radius: 4px; font-size: .64rem; font-weight: 700; letter-spacing: .06em; line-height: 1.5; color: #6b6b6b; text-transform: uppercase; vertical-align: 2px; }
  .mark.spicy { border-color: #d9a39f; color: #b3261e; }

  .photos { display: grid; gap: 1.2rem; position: sticky; top: 9.5rem; }
  figure { margin: 0; }
  figure img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 20px; background: #eee; }
  figcaption { margin-top: .5rem; font-size: .82rem; color: #777; }
  @media (max-width: 860px) {
    .panel { grid-template-columns: 1fr; }
    .main { display: contents; }
    .phead { order: 0; } .photos { order: 1; } .list { order: 2; margin-top: 0; }
    .photos { position: static; grid-auto-flow: column; grid-auto-columns: 1fr; gap: .6rem; }
    figure img { border-radius: 14px; }
    figcaption { font-size: .75rem; line-height: 1.3; }
    .panel--plain .list { columns: 1; }
    .d { padding-right: 1.5rem; }
  }
</style>
