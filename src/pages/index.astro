---
// Home page for kitchen121.com.
// ALL content below is PLACEHOLDER. Replace with the client's real name, copy, menu, hours and photos.
// Do not publish invented facts, prices or reviews.
import Base from '../layouts/Base.astro';

const menu = [
  { name: '[Menu item 1]', desc: '[Placeholder description]', price: '[price]' },
  { name: '[Menu item 2]', desc: '[Placeholder description]', price: '[price]' },
  { name: '[Menu item 3]', desc: '[Placeholder description]', price: '[price]' },
];
---
<Base title="Kitchen 121">
  <header class="nav">
    <a class="brand" href={import.meta.env.BASE_URL}>Kitchen <span>121</span></a>
    <nav>
      <a href="#about">About</a>
      <a href="#menu">Menu</a>
      <a href="#visit">Visit</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <p class="tag">[Placeholder tagline]</p>
      <h1>Kitchen <span>121</span></h1>
      <p class="lede">[Placeholder: one sentence about what makes this business special.]</p>
      <a class="btn" href="#visit">[Primary call to action]</a>
    </section>

    <section id="about" class="block">
      <h2>About</h2>
      <p>[Placeholder: the client's story, in their own words. Replace this paragraph with real copy.]</p>
    </section>

    <section id="menu" class="block alt">
      <h2>Menu</h2>
      <ul class="menu">
        {menu.map((m) => (
          <li>
            <div><strong>{m.name}</strong><span>{m.desc}</span></div>
            <em>{m.price}</em>
          </li>
        ))}
      </ul>
    </section>

    <section id="visit" class="block">
      <h2>Visit</h2>
      <p><strong>Address:</strong> [placeholder]</p>
      <p><strong>Hours:</strong> [placeholder]</p>
      <p><strong>Phone / email:</strong> [placeholder]</p>
    </section>
  </main>

  <footer>
    <p>&copy; Kitchen 121. [Placeholder footer]</p>
  </footer>
</Base>

<style is:global>
  :root { --brand: #c2410c; --ink: #1c1917; --bg: #fffaf5; --alt: #fff1e3; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; color: var(--ink); background: var(--bg); line-height: 1.6; }
  a { color: inherit; }
  .nav { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 24px; position: sticky; top: 0; background: var(--bg); border-bottom: 1px solid #0000001a; }
  .brand { font-weight: 800; text-decoration: none; font-size: 1.25rem; }
  .brand span, h1 span { color: var(--brand); }
  .nav nav { display: flex; gap: 20px; }
  .nav nav a { text-decoration: none; font-weight: 600; }
  .hero { text-align: center; padding: 96px 24px; max-width: 760px; margin: 0 auto; }
  .tag { text-transform: uppercase; letter-spacing: .12em; font-size: .8rem; font-weight: 700; color: var(--brand); }
  h1 { font-size: clamp(2.8rem, 9vw, 5rem); line-height: 1.05; margin: 8px 0 16px; }
  .lede { font-size: 1.15rem; margin-bottom: 28px; }
  .btn { display: inline-block; background: var(--brand); color: #fff; text-decoration: none; font-weight: 700; padding: 14px 28px; border-radius: 999px; }
  .block { padding: 64px 24px; }
  .block > * { max-width: 760px; margin-left: auto; margin-right: auto; }
  .alt { background: var(--alt); }
  h2 { font-size: 2rem; margin-top: 0; }
  .menu { list-style: none; padding: 0; }
  .menu li { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px dashed #0003; }
  .menu span { display: block; font-size: .95rem; opacity: .8; }
  .menu em { font-style: normal; font-weight: 700; }
  footer { text-align: center; padding: 32px 24px; font-size: .9rem; opacity: .75; }
</style>
