---
// Catering 121. Copy is from the client's current Catering page; platters and prices are from the current printed menus.
// Same design as the home page: cream paper, thin rules, the restaurant's own photos.
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import { LOCATIONS, EMAIL, address } from '../../data/site';
import { partyPlatters, RAW_NOTICE } from '../../data/menu';
import red from '../../assets/home/red-pepper.webp';
import roll from '../../assets/home/roll.webp';
const groups = [
  { t: 'Chicken platters', img: red, alt: 'Red pepper fried chicken', items: partyPlatters.items.filter((i) => /chicken/i.test(i.n)) },
  { t: 'Roll platters', img: roll, alt: 'A crunch sushi roll with orange roe', items: partyPlatters.items.filter((i) => !/chicken/i.test(i.n)) },
];
---
<Site title="Catering 121 | Kitchen 121" description="Kitchen 121 catering: boxes, trays and party platters of signature chicken and sushi rolls for family or corporate events in Duluth and Hamilton Mill, GA." active="catering">
  <PageHero eyebrow="Catering 121" title="Boxes or trays" lead="Kitchen 121 also offers catering services. Whether you prefer boxes or trays, we have the perfectly-portioned catering option for your family or corporate event." banner="catering" position="55% 50%">
    <a class="pill" href="#contact"><span>Contact Us for Details</span><span class="arrow">&rarr;</span></a>
  </PageHero>

  <section class="cream plat">
    <div class="container">
      <div class="statement"><p>Perfectly-portioned chicken and roll platters for family and corporate events, <span>serving 2 to 5 each.</span></p></div>
      <header class="k-sh"><h2>121 Party Platter</h2><a class="k-tl" href="#contact">Order catering &rarr;</a></header>
      <div class="two">
        {groups.map((g) => (
          <article>
            <figure><img src={g.img.src} width={g.img.width} height={g.img.height} alt={g.alt} loading="lazy" /></figure>
            <h3>{g.t}</h3>
            <ul>
              {g.items.map((i) => (
                <li>
                  <div class="row"><span class="n">{i.n}{i.raw && <span class="raw">*</span>}</span><b>${i.p}</b></div>
                  <p class="d"><span class="serves">{i.serves}{i.d && '. '}</span>{i.d}</p>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <p class="fine"><b>*</b> {RAW_NOTICE}</p>
    </div>
  </section>

  <section class="cream contact" id="contact">
    <div class="container">
      <header class="k-sh"><h2>Contact us for details</h2><a class="k-tl" href={`mailto:${EMAIL}?subject=Catering%20request`}>{EMAIL}</a></header>
      <div class="two locs">
        {LOCATIONS.map((l) => (
          <article>
            <p class="k-label">{l.short}</p>
            <p class="addr">{address(l)}</p>
            <a class="pill pill--sm" href={`tel:${l.tel}`}>Call {l.phone}</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Site>

<style>
  .plat { padding: 0 0 clamp(56px, 8vw, 96px); }
  .statement { padding: clamp(36px, 6vw, 64px) 0; text-align: center; }
  .statement p { margin: 0 auto; max-width: 40rem; font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.5; color: var(--muted); }
  .statement span { color: var(--green); font-weight: 600; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
  figure { margin: 0 0 1.2rem; border-radius: 4px; overflow: hidden; }
  figure img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  h3 { font-size: clamp(1.8rem, 3vw, 2.4rem); padding-bottom: .7rem; border-bottom: 1px solid var(--rule); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: .85rem 0; border-bottom: 1px solid var(--rule); }
  .row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .n { font-weight: 600; font-size: 1.05rem; } .raw { color: var(--green); }
  .row b { font-family: var(--display); font-weight: 800; font-size: 1.5rem; line-height: 1; color: var(--green); }
  .d { margin: .2rem 0 0; padding-right: 3rem; font-size: .9rem; line-height: 1.45; color: var(--muted); }
  .serves { font-weight: 600; color: #444; }
  .fine { margin: 1.8rem 0 0; font-size: .82rem; line-height: 1.5; color: var(--muted); }
  .fine b { color: var(--green); }
  .contact { padding: 0 0 clamp(56px, 8vw, 96px); }
  .locs article { padding: 0 0 .4rem; }
  .addr { margin: 0 0 1rem; font-size: 1.1rem; font-weight: 500; }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } .d { padding-right: 1rem; } }
</style>
