---
// Locations. Addresses, landmarks, hours, phones and e-mail are from the client's current Locations page.
// Same design as the home page: cream paper, thin rules.
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/PageHero.astro';
import Map from '../../components/Map.astro';
import { LOCATIONS, HOURS, EMAIL, address, directions } from '../../data/site';
import { STOREFRONTS } from '../../data/storefronts';
---
<Site title="Locations | Kitchen 121" description="Find Kitchen 121 in Duluth (1611 Satellite Blvd. STE 17) and Hamilton Mill (2680 Hamilton Mill Rd, Buford). Open Tuesday to Sunday 11:30am to 9pm." active="locations">
  <PageHero eyebrow="Find us" title="Locations" lead="Two kitchens, the same high quality casual dining. Open Tuesday to Sunday 11:30am to 9pm, closed Monday." banner="locations" position="50% 45%" />

  <section class="cream visit">
    <div class="container stack">
      {LOCATIONS.map((l, i) => (
        <article id={l.id}>
          <header class="k-sh"><h2>{l.name}</h2><div class="links"><a class="pill pill--sm" href={l.order.clover} data-order={l.id}>Order</a><a class="k-tl" href={l.menu}>Menu</a><a class="k-tl" href={directions(l)} rel="noopener">Directions</a></div></header>
          <div class="grid">
            <figure><img src={STOREFRONTS[l.id].img.src} width={STOREFRONTS[l.id].img.width} height={STOREFRONTS[l.id].img.height} alt={STOREFRONTS[l.id].alt} style={`object-position:${STOREFRONTS[l.id].position}`} loading={i ? 'lazy' : 'eager'} /></figure>
            <dl>
              <div><dt>Address</dt><dd>{l.street}<br />{l.city}<span class="note">{l.note}</span></dd></div>
              <div><dt>Hours</dt><dd>{HOURS.map((h) => <span class="hr">{h.days}: {h.time}</span>)}</dd></div>
              <div><dt>Phone</dt><dd><a href={`tel:${l.tel}`}>{l.phone}</a></dd></div>
            </dl>
          </div>
          <div class="map"><Map query={`Kitchen 121 ${address(l)}`} title={`Map showing ${l.name}`} /></div>
        </article>
      ))}
    </div>
  </section>

  <section class="cream ask">
    <div class="container">
      <header class="k-sh"><h2>Any questions or messages?</h2><a class="k-tl" href={`mailto:${EMAIL}`}>{EMAIL}</a></header>
      <p class="sub">Please send an e-mail to {EMAIL} or call {LOCATIONS.map((l) => `${l.phone} (${l.short})`).join(' or ')}.</p>
    </div>
  </section>
</Site>

<style>
  .visit { padding: clamp(48px, 7vw, 88px) 0 clamp(40px, 6vw, 72px); }
  .stack { display: grid; gap: clamp(56px, 8vw, 104px); }
  article { scroll-margin-top: 6rem; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 1.1rem; }
  .grid { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
  figure { margin: 0; border-radius: 4px; overflow: hidden; }
  figure img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; }
  dl { margin: 0; display: grid; }
  dl > div { padding: 1rem 0; border-bottom: 1px solid var(--rule); }
  dl > div:first-child { padding-top: 0; }
  dt { font-family: var(--display); font-weight: 700; font-size: 1rem; letter-spacing: .2em; text-transform: uppercase; color: var(--green); }
  dd { margin: .3rem 0 0; font-weight: 500; font-size: 1.08rem; line-height: 1.5; }
  dd a { color: inherit; text-decoration: none; border-bottom: 2px solid rgb(15 102 54 / .35); }
  dd a:hover { color: var(--green); border-bottom-color: var(--green); }
  .note { display: block; margin-top: .2rem; font-weight: 400; font-size: .95rem; color: var(--muted); }
  .hr { display: block; }
  .map { margin-top: clamp(20px, 3vw, 32px); }
  .map :global(.map) { aspect-ratio: 21 / 8; border-radius: 4px; box-shadow: none; }
  .ask { padding: 0 0 clamp(56px, 8vw, 96px); }
  .sub { margin: 0; max-width: 44rem; color: var(--muted); font-size: 1.05rem; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } .map :global(.map) { aspect-ratio: 4 / 3; } }
</style>
