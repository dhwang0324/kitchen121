---
// Home. The banner (AI-generated, see src/data/banners.ts) stays; everything below it is laid out like a printed menu:
// a serif statement, the client's own photos, the menu at a glance, the chef, both kitchens and catering.
// Facts and prices come from the client's current site and menus (src/data/); photos are their own (src/assets/real/).
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/400-italic.css';
import '@fontsource/fraunces/600.css';
import Site from '../layouts/Site.astro';
import { u, LOCATIONS, HOURS, directions } from '../data/site';
import { MENUS } from '../data/menu';
import { BANNERS } from '../data/banners';
import pTable from '../assets/real/table.webp';
import pFlavors from '../assets/real/chicken-flavors.webp';
import pRoll from '../assets/real/roll.webp';
import pPlatter from '../assets/real/roll-platter.webp';
import pBoxes from '../assets/real/chicken-boxes.webp';
import pChef from '../assets/real/chef.webp';
const hero = BANNERS.home;

// Menu at a glance: price ranges across both kitchens, from the menu data.
const all = [...MENUS.duluth, ...MENUS['hamilton-mill']];
const range = (ids: string[]) => {
  const ps = all.filter((s) => ids.includes(s.id)).flatMap((s) => s.items.map((i) => i.p));
  const lo = Math.min(...ps), hi = Math.max(...ps);
  return lo === hi ? `$${lo}` : `$${lo}–${hi}`;
};
const glance = [
  { name: 'Signature Chicken', note: 'A 1.5 lb house-craft chicken breast with a hand-made sauce: soy garlic, red pepper, sweet onion, snow cheese, lemon pepper and more.', price: range(['signature-chicken']) },
  { name: 'Special Rolls', note: 'Yummy Yummy, Special Eel, Double Shrimp Tempura and Extreme Beauty.', price: range(['special-roll']) },
  { name: 'Rolls', note: 'Rainbow, caterpillar, spicy tuna, rice paper rolls and the classics.', price: range(['roll']) },
  { name: 'Bowls & Salads', note: 'Hot bowls with a sunny side up egg, sushi and poke bowls, house salads.', price: range(['hot-bowl', 'sushi-bowl', 'salad-bowl', 'cool-salad']) },
  { name: 'Udon', note: 'Thick udon, stir fried or in soup.', price: range(['noodle-bowl']) },
  { name: 'Small Plates', note: 'Carpaccio, mini rolls, dumplings, takoyaki, nigiri.', price: range(['appetizers', 'small-plate']) },
];
const platter = range(['party-platter']);
---
<Site title="Kitchen 121 | Clean food for your body and soul" active="home">
  <section class="hero" aria-label="Welcome">
    <img class="photo" src={hero.src} srcset={hero.srcset} sizes="100vw" width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high" />
    <div class="shade"></div>
    <div class="container content">
      <div class="copy rise">
        <p class="chip">Since 2017 &middot; Duluth &amp; Hamilton Mill</p>
        <h1><span class="l">Clean food</span> <span class="l">for your</span> <span class="l block"><span>Body &amp; Soul</span></span></h1>
        <p class="lead">Signature chicken, sushi rolls and bowls by Chef Ji Young Lee.</p>
        <div class="cta">
          <a class="pill" href={u('locations/')} data-order><span>Order Now</span><span class="arrow">&rarr;</span></a>
          <a class="pill pill--ghost" href={u('menu/')}>See the Menu</a>
        </div>
      </div>
    </div>
  </section>


  <section class="intro">
    <div class="container grid">
      <p class="statement" data-a>Korean fried chicken, sushi rolls and bowls, made by hand by Chef Ji Young Lee. <em>Clean food for your body and soul,</em> in Duluth since 2017 and now in Hamilton Mill.</p>
      <ul class="facts" data-a>
        <li><b>2017</b><span>First kitchen opens in Duluth</span></li>
        <li><b>2</b><span>Kitchens: Duluth and Hamilton Mill</span></li>
        <li><b>Top 100</b><span>Yelp Sushi Spots, 2024</span></li>
      </ul>
    </div>
  </section>

  <section class="gallery" aria-label="From our kitchen">
    <div class="container">
      <div class="g">
        <figure class="a" data-a><img src={pFlavors.src} width={pFlavors.width} height={pFlavors.height} alt="Signature chicken in red pepper, sweet onion, jalapeño parmesan and oriental soy garlic" loading="lazy" /></figure>
        <figure class="b" data-a><img src={pTable.src} width={pTable.width} height={pTable.height} alt="A table of poke, fried chicken and rolls at Kitchen 121" loading="lazy" /><figcaption>Lunch for the table</figcaption></figure>
        <figure class="c" data-a><img src={pRoll.src} width={pRoll.width} height={pRoll.height} alt="A sushi roll topped with tuna and eel sauce" loading="lazy" /><figcaption>From the sushi bar</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="glance">
    <div class="container">
      <header class="sh" data-a>
        <h2>The menu, <em>briefly</em></h2>
        <a class="tl" href={u('menu/')}>See the full menu &rarr;</a>
      </header>
      <ul class="cats">
        {glance.map((c, i) => (
          <li data-a>
            <span class="no">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{c.name}</h3><p>{c.note}</p></div>
            <b>{c.price}</b>
          </li>
        ))}
      </ul>
      <p class="small" data-a>Our two kitchens have slightly different menus. Prices from the current printed menus.</p>
    </div>
  </section>

  <section class="chef">
    <div class="container grid">
      <figure data-a><img src={pChef.src} width={pChef.width} height={pChef.height} alt="Chef Ji Young Lee" loading="lazy" /></figure>
      <div data-a>
        <h2>By Chef <em>Ji Young Lee</em></h2>
        <p>Before opening Kitchen 121, Chef Ji Young Lee trained at Le Cordon Bleu College of Culinary Arts and cooked at The Ritz-Carlton, Atlanta. Everything on the menu, from the sauces on the chicken to the dressings on the salads, is made in our own kitchen.</p>
        <dl>
          <div><dt>Training</dt><dd>Le Cordon Bleu College of Culinary Arts</dd></div>
          <div><dt>2015 to 2016</dt><dd>The Ritz-Carlton, Atlanta</dd></div>
          <div><dt>2017 to today</dt><dd>Owner chef, Group 121</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="visit" id="kitchens">
    <div class="container">
      <header class="sh" data-a><h2>Visit <em>either kitchen</em></h2></header>
      <div class="two">
        {LOCATIONS.map((l) => (
          <article data-a>
            <h3>{l.short}</h3>
            <p class="addr">{l.street}<br />{l.city}</p>
            <p class="note">{l.note}</p>
            <p class="hrs">{HOURS[1].days}, {HOURS[1].time}<br />{HOURS[0].days}, {HOURS[0].time.toLowerCase()}</p>
            <p class="tel"><a href={`tel:${l.tel}`}>{l.phone}</a></p>
            <nav class="links" aria-label={`${l.short} links`}>
              <a class="pill pill--sm" href={l.order.clover} data-order={l.id}><span>Order</span><span class="arrow">&rarr;</span></a>
              <a class="tl" href={l.menu}>Menu</a>
              <a class="tl" href={directions(l)} rel="noopener">Directions</a>
            </nav>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cater">
    <div class="container grid">
      <figure data-a><img src={pPlatter.src} width={pPlatter.width} height={pPlatter.height} alt="Trays of assorted sushi rolls" loading="lazy" /><img src={pBoxes.src} width={pBoxes.width} height={pBoxes.height} alt="Boxes of signature chicken in several flavors" loading="lazy" /></figure>
      <div data-a>
        <h2>Catering, <em>boxes or trays</em></h2>
        <p>Perfectly-portioned chicken and roll platters for family and corporate events, {platter}.</p>
        <a class="tl tl--light" href={u('catering/')}>Catering details &rarr;</a>
      </div>
    </div>
  </section>
</Site>

<style>
  /* ---------- hero: copy on the left, a tilted wall of real dishes on the right ---------- */
  .hero { position: relative; display: flex; align-items: center; overflow: hidden; min-height: min(92svh, 860px); background: var(--ink); }
  .photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 75% 50%; display: block; }
  @media (prefers-reduced-motion: no-preference) { .photo { animation: settle 1.8s cubic-bezier(.2, .6, .2, 1) both; } @keyframes settle { from { transform: scale(1.06); } to { transform: none; } } }
  .shade { position: absolute; inset: 0; pointer-events: none; background:
    linear-gradient(to bottom, rgb(20 20 20 / .75) 0, rgb(20 20 20 / .2) 120px, transparent 220px),
    linear-gradient(to right, rgb(20 20 20 / .9) 0, rgb(20 20 20 / .6) 34%, rgb(20 20 20 / .1) 62%, transparent 80%); }
  .content { position: relative; z-index: 2; padding-block: 7rem 4rem; }
  .copy { max-width: 40rem; }
  h1 { margin: 1.1rem 0 1.5rem; font-size: clamp(3.4rem, 7.6vw, 6.8rem); line-height: .9; letter-spacing: .005em; }
  h1 .l { display: block; }
  h1 .block { margin-top: .14em; }
  h1 .block span { display: inline-block; white-space: nowrap; padding: .08em .24em .03em; margin-left: -.06em; background: var(--green); transform: rotate(-3deg); transform-origin: left center; box-shadow: 0 14px 40px rgb(0 0 0 / .35); }
  .lead { margin: 0 0 1.9rem; max-width: 28rem; font-size: 1.15rem; line-height: 1.5; color: #e2e2e2; }
  .cta { display: flex; flex-wrap: wrap; gap: .9rem; }
  @media (max-width: 860px) {
    .hero { align-items: flex-end; min-height: 100svh; }
    .photo { object-position: 78% 50%; }
    .shade { background:
      linear-gradient(to bottom, rgb(20 20 20 / .8) 0, rgb(20 20 20 / .15) 110px, transparent 200px),
      linear-gradient(to top, rgb(20 20 20 / .95) 0, rgb(20 20 20 / .75) 40%, rgb(20 20 20 / .15) 75%); }
    .content { padding-block: 0 3rem; }
    .copy { margin-inline: auto; text-align: center; }
    h1 .block span { transform-origin: center; }
    .lead { margin-inline: auto; }
    .cta { justify-content: center; }
  }

  /* ---------- shared ---------- */
  .serif, .statement, h2, h3, .chef p { font-family: 'Fraunces', Georgia, serif; }
  h2 { text-transform: none; font-weight: 400; font-size: clamp(2.2rem, 4.6vw, 3.6rem); line-height: 1.05; letter-spacing: -.01em; }
  h2 em, .statement em { font-style: italic; color: var(--green); }
  .tl { color: inherit; font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; text-decoration-color: var(--green); white-space: nowrap; }
  .tl:hover { color: var(--green); }
  .sh { display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; padding-bottom: 1.4rem; border-bottom: 1px solid currentColor; }

  /* ---------- intro statement ---------- */
  .intro { background: var(--paper); color: var(--ink); padding: clamp(64px, 10vw, 140px) 0 clamp(40px, 6vw, 72px); }
  .intro .grid { display: grid; grid-template-columns: 8fr 4fr; gap: clamp(2rem, 6vw, 6rem); align-items: end; }
  .statement { margin: 0; font-size: clamp(1.7rem, 3.4vw, 2.75rem); line-height: 1.22; letter-spacing: -.01em; }
  .facts { list-style: none; margin: 0; padding: 0; }
  .facts li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; align-items: baseline; padding: .9rem 0; border-top: 1px solid rgb(0 0 0 / .15); }
  .facts li:last-child { border-bottom: 1px solid rgb(0 0 0 / .15); }
  .facts b { font-family: var(--display); font-weight: 800; font-size: 1.9rem; line-height: 1; text-transform: uppercase; color: var(--green); }
  .facts span { font-size: .92rem; color: #555; }

  /* ---------- gallery of their own photos ---------- */
  .gallery { background: var(--paper); padding-bottom: clamp(64px, 9vw, 120px); }
  .g { display: grid; grid-template-columns: 1fr 1fr; grid-template-areas: 'a b' 'a c'; gap: 14px; }
  .g figure { margin: 0; position: relative; overflow: hidden; background: #ddd; }
  .g img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .a { grid-area: a; aspect-ratio: 1; } .b { grid-area: b; } .c { grid-area: c; }
  .b, .c { height: 100%; min-height: 0; }
  .g figcaption { position: absolute; left: 0; bottom: 0; padding: .45rem .8rem .35rem; background: var(--paper); color: var(--ink); font-family: var(--display); font-weight: 700; font-size: .95rem; letter-spacing: .1em; text-transform: uppercase; }

  /* ---------- menu at a glance ---------- */
  .glance { background: var(--ink); color: #f3efe7; padding: clamp(64px, 9vw, 120px) 0; }
  .glance .sh { border-color: rgb(255 255 255 / .35); }
  .glance h2 em { color: var(--leaf); }
  .glance .tl { text-decoration-color: var(--leaf); }
  .glance .tl:hover { color: var(--leaf); }
  .cats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(2rem, 5vw, 5rem); }
  .cats li { display: grid; grid-template-columns: 2.4rem 1fr auto; gap: 1rem; align-items: baseline; padding: 1.5rem 0; border-bottom: 1px solid rgb(255 255 255 / .14); }
  .no { font-family: var(--display); font-weight: 700; font-size: 1rem; color: var(--leaf); }
  .cats h3 { text-transform: none; font-weight: 600; font-size: 1.55rem; line-height: 1.1; }
  .cats p { margin: .35rem 0 0; font-size: .92rem; line-height: 1.5; color: #b9b5ad; }
  .cats b { font-family: var(--display); font-weight: 700; font-size: 1.35rem; letter-spacing: .02em; white-space: nowrap; }
  .small { margin: 1.4rem 0 0; font-size: .82rem; color: #8f8b84; }

  /* ---------- chef ---------- */
  .chef { background: var(--paper); color: var(--ink); padding: clamp(64px, 9vw, 120px) 0; }
  .chef .grid { display: grid; grid-template-columns: minmax(150px, 220px) 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; max-width: 62rem; }
  .chef figure { margin: 0; }
  .chef figure img { display: block; width: 100%; height: auto; filter: grayscale(1) contrast(1.05); }
  .chef p { margin: 1.2rem 0 0; font-size: 1.2rem; line-height: 1.55; color: #333; }
  .chef dl { margin: 2rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .chef dt { font-family: var(--display); font-weight: 700; font-size: .95rem; letter-spacing: .1em; text-transform: uppercase; color: var(--green); }
  .chef dd { margin: .3rem 0 0; font-size: .92rem; line-height: 1.4; color: #444; }

  /* ---------- visit ---------- */
  .visit { background: #ece6da; color: var(--ink); padding: clamp(64px, 9vw, 120px) 0; scroll-margin-top: 4rem; }
  .two { display: grid; grid-template-columns: 1fr 1fr; }
  .two article { padding: 2.2rem clamp(1rem, 4vw, 3.5rem) 0 0; }
  .two article + article { border-left: 1px solid rgb(0 0 0 / .2); padding-left: clamp(1.5rem, 4vw, 3.5rem); }
  .two h3 { text-transform: none; font-weight: 400; font-size: clamp(2rem, 3.6vw, 2.8rem); }
  .addr { margin: .9rem 0 0; font-size: 1.1rem; font-weight: 600; line-height: 1.45; }
  .note { margin: .3rem 0 0; font-size: .92rem; color: #5d5a54; }
  .hrs { margin: 1rem 0 0; font-size: .95rem; line-height: 1.5; color: #333; }
  .tel { margin: .6rem 0 0; } .tel a { color: inherit; font-weight: 600; text-decoration: none; }
  .links { display: flex; align-items: center; flex-wrap: wrap; gap: 1.4rem; margin-top: 1.6rem; }

  /* ---------- catering ---------- */
  .cater { background: var(--green); color: #fff; padding: clamp(56px, 8vw, 100px) 0; }
  .cater .grid { display: grid; grid-template-columns: 6fr 5fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .cater figure { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .cater figure img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; }
  .cater h2 em { color: #cfe9d8; }
  .cater p { margin: 1rem 0 1.4rem; font-size: 1.08rem; line-height: 1.55; color: #e3f1e8; max-width: 30rem; }
  .tl--light { text-decoration-color: #fff; } .tl--light:hover { color: #cfe9d8; }

  @media (max-width: 860px) {
    .intro .grid, .chef .grid, .cater .grid { grid-template-columns: 1fr; }
    .g { grid-template-columns: 1fr; grid-template-areas: 'a' 'b' 'c'; }
    .b, .c { aspect-ratio: 2.1 / 1; }
    .g figcaption { font-size: .8rem; }
    .cats { grid-template-columns: 1fr; }
    .chef figure { width: 160px; }
    .chef dl { grid-template-columns: 1fr; }
    .two { grid-template-columns: 1fr; }
    .two article { padding-right: 0; }
    .two article + article { border-left: 0; border-top: 1px solid rgb(0 0 0 / .2); padding-left: 0; margin-top: 2.2rem; }
  }
</style>
