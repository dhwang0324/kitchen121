---
// One menu category as a white panel: heading, base / add-on notes, the item list with dotted leaders and green prices,
// and that category's photos as tilted tiles. Long lists run in two columns with the photos across the top.
import { food } from '../data/site';
import type { Section } from '../data/menu';
interface Props { section: Section }
const { section: s } = Astro.props;
const long = s.items.length > 10;
const photos = s.photos ?? [];
const layout = photos.length === 0 ? 'plain' : long ? 'wide' : 'side';
---
<section class:list={['panel', `panel--${layout}`]} id={s.id} data-a>
  <header class="phead">
    <h2>{s.title}</h2>
    {(s.note || s.extra) && <p class="note">{s.note} {s.extra && <b>{s.extra}</b>}</p>}
  </header>
  {photos.length > 0 && (
    <div class="photos" data-n={photos.length}>
      {photos.map((p) => { const im = food(p.img); return (
        <figure><span class="tile"><img src={im.src} alt={p.cap} width={im.width} height={im.height} loading="lazy" /></span><figcaption>{p.cap}</figcaption></figure>
      ); })}
    </div>
  )}
  <ul class:list={['list', (long || layout === 'plain') && 'list--2']}>
    {s.items.map((i) => (
      <li>
        <div class="row">
          <span class="n">{i.n}{i.raw && <span class="raw" title="Served undercooked or may contain raw ingredient">*</span>}
            {i.spicy && <span class="spicy">Spicy</span>}
            {i.v && <span class="mark v" title="Marked V on our printed menu">V</span>}
            {i.g && <span class="mark g" title="Marked G on our printed menu">G</span>}
          </span>
          <span class="dots" aria-hidden="true"></span>
          <b>${i.p}</b>
        </div>
        {(i.d || i.serves) && <p class="d">{i.serves && <span class="serves">{i.serves}{i.d && '. '}</span>}{i.d}</p>}
      </li>
    ))}
  </ul>
</section>

<style>
  .panel { background: #fff; color: var(--ink); border-radius: 30px; padding: clamp(22px, 4vw, 52px); box-shadow: 0 10px 40px rgb(0 0 0 / .06); display: grid; gap: clamp(1.2rem, 3vw, 2.4rem) clamp(1.5rem, 4vw, 3.5rem); scroll-margin-top: 9.5rem; }
  .panel--side { grid-template-columns: 7fr 5fr; grid-template-rows: auto 1fr; grid-template-areas: 'head photos' 'list photos'; align-items: start; }
  .panel--side .phead { grid-area: head; } .panel--side .list { grid-area: list; } .panel--side .photos { grid-area: photos; align-self: center; }
  h2 { font-size: clamp(2.4rem, 5vw, 3.8rem); }
  h2::after { content: ''; display: block; width: 3.2rem; height: .5rem; margin-top: .7rem; background: var(--green); transform: skewX(-17deg); }
  .note { margin: .9rem 0 0; max-width: 46rem; font-size: .95rem; color: #5f5f5f; }
  .note b { display: inline-block; margin-left: .2rem; padding: .1rem .6rem; border-radius: 999px; background: rgb(15 102 54 / .1); color: var(--green); font-weight: 600; font-size: .85rem; white-space: nowrap; }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: .95rem; align-content: start; }
  .list--2 { display: block; columns: 2; column-gap: clamp(1.5rem, 4vw, 3.5rem); }
  .list--2 li { break-inside: avoid; padding-bottom: .95rem; }
  .row { display: flex; align-items: baseline; gap: .6rem; }
  .n { font-weight: 700; font-size: 1.02rem; line-height: 1.3; }
  .raw { color: var(--green); font-weight: 700; margin-left: 1px; }
  .dots { flex: 1; border-bottom: 2px dotted rgb(0 0 0 / .25); transform: translateY(-4px); min-width: 16px; }
  .row b { font-family: var(--display); font-weight: 800; font-size: 1.6rem; line-height: 1; letter-spacing: .02em; color: var(--green); }
  .d { margin: .15rem 0 0; padding-right: 2.5rem; font-size: .9rem; line-height: 1.45; color: #6b6b6b; }
  .serves { font-weight: 600; color: #444; }
  .mark { display: inline-grid; place-items: center; width: 1.15rem; height: 1.15rem; margin-left: .25rem; border-radius: 50%; font-size: .68rem; font-weight: 800; line-height: 1; color: #fff; vertical-align: 2px; }
  .mark.v { background: #3a9a3a; } .mark.g { background: #e8871e; }
  .spicy { display: inline-block; margin-left: .3rem; padding: .12rem .4rem .08rem; border-radius: 4px; background: #c8281e; color: #fff; font-size: .62rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; line-height: 1.2; vertical-align: 2px; }

  .photos { display: grid; gap: clamp(1rem, 2.5vw, 1.8rem); }
  .panel--wide .photos { grid-template-columns: repeat(3, 1fr); padding: .6rem .4rem 0; }
  .panel--side .photos figure:nth-child(n+3) { display: none; }
  .panel--side .photos { padding: .5rem 6% .5rem 4%; }
  figure { margin: 0; }
  .tile { aspect-ratio: 4 / 3; transform: rotate(-3deg); }
  figure:nth-child(even) .tile { transform: rotate(3deg); }
  figcaption { margin-top: .8rem; text-align: center; font-family: var(--display); font-weight: 700; font-size: 1.05rem; letter-spacing: .08em; text-transform: uppercase; color: #555; line-height: 1.15; }
  @media (max-width: 860px) {
    .panel--side { grid-template-columns: 1fr; grid-template-areas: 'head' 'photos' 'list'; }
    .panel--side .photos { grid-template-columns: repeat(2, 1fr); padding: .4rem .2rem 0; }
    .panel--wide .photos { gap: .7rem; }
    .list--2 { columns: 1; }
    .d { padding-right: 1rem; }
    figcaption { font-size: .9rem; }
  }
</style>
