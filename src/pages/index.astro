---
// Home. Structure follows the Chicken 121 home (hero, signature dishes, photo band, about, menu teaser, Instagram),
// plus the location chooser that is the main job of the current kitchen121.com home page.
// Copy and facts come from the client's current site and printed menus; photos are cropped from their own images.
import Site from '../layouts/Site.astro';
import { u, LOCATIONS, HOURS, TAGLINE, INSTAGRAM, INSTAGRAM_HANDLE, food, directions } from '../data/site';
import { partyPlatters } from '../data/menu';

const mosaic = [
  { img: 'c-poke', alt: 'Poke bowl with tuna, salmon and avocado' },
  { img: 'c-roll', alt: 'Sushi roll topped with tuna and eel sauce' },
  { img: 'c-chicken-boxes', alt: 'Boxes of Kitchen 121 signature chicken in several flavors' },
  { img: 'c-table', alt: 'A table at Kitchen 121 with a sushi bowl, fried chicken and rolls' },
  { img: 'c-roll-platter', alt: 'Trays of assorted sushi rolls' },
  { img: 'c-sashimi', alt: 'Salmon and scallop sashimi' },
];
const signature = [
  { img: 'chicken-soy-garlic', name: 'Oriental Soy Garlic Chicken', price: 17, line: '121 Signature Chicken' },
  { img: 'special-yummy', name: '121 Yummy Yummy Roll', price: 16, line: '121 Special Roll' },
  { img: 'chicken-snow-cheese', name: 'Snow Cheese Chicken', price: 17, line: '121 Signature Chicken' },
  { img: 'special-extreme-beauty', name: '121 Extreme Beauty Roll', price: 16, line: '121 Special Roll' },
  { img: 'chicken-red-pepper', name: 'Red Pepper Chicken', price: 17, line: '121 Signature Chicken' },
  { img: 'special-double-shrimp', name: '121 Double Shrimp Tempura Roll', price: 16, line: '121 Special Roll' },
];
const strip = ['c-roll-platter', 'chicken-sweet-onion', 'c-sashimi', 'hot-bulgogi', 'c-poke', 'chicken-lemon-pepper', 'c-roll'];
const cardArt = { duluth: 'c-table', 'hamilton-mill': 'c-chicken-boxes' } as const;
const insta = ['c-poke', 'chicken-jalapeno-parmesan', 'roll-caterpillar', 'hot-salmon', 'c-sashimi', 'sushi-bowl'];
const chef = food('chef');
const fromPrice = Math.min(...partyPlatters.items.map((i) => i.p));
---
<Site title="Kitchen 121 | Clean food for your body and soul" active="home">
  <section class="hero" aria-label="Welcome">
    <div class="mosaic" aria-hidden="true">
      <div class="col">{mosaic.slice(0, 3).map((m) => <span class="tile"><img src={food(m.img).src} alt="" width={food(m.img).width} height={food(m.img).height} /></span>)}</div>
      <div class="col col--b">{mosaic.slice(3).map((m) => <span class="tile"><img src={food(m.img).src} alt="" width={food(m.img).width} height={food(m.img).height} /></span>)}</div>
    </div>
    <div class="shade"></div>
    <div class="container content">
      <div class="copy rise">
        <p class="chip">Since 2017 &middot; Duluth &amp; Hamilton Mill</p>
        <h1><span class="l">Clean food</span> <span class="l">for your</span> <span class="l block"><span>Body &amp; Soul</span></span></h1>
        <p class="lead">Signature chicken, sushi rolls and bowls by Chef Ji Young Lee.</p>
        <div class="cta">
          <a class="pill" href={u('locations/')} data-order><span>Order Online</span><span class="arrow">&rarr;</span></a>
          <a class="pill pill--ghost" href="#kitchens">See the Menus</a>
        </div>
      </div>
    </div>
  </section>

  <section class="kitchens" id="kitchens">
    <div class="container">
      <div class="head" data-a>
        <p class="eyebrow">Two locations, one kitchen</p>
        <h2 class="h2">Pick your kitchen</h2>
        <p class="sub">Both of our locations offer the same high quality casual dining. Choose your location to see the menu and order online.</p>
      </div>
      <div class="two">
        {LOCATIONS.map((l, i) => (
          <article class="kcard" data-a>
            <a class="art" href={l.menu} tabindex="-1" aria-hidden="true"><img src={food(cardArt[l.id]).src} alt="" width={food(cardArt[l.id]).width} height={food(cardArt[l.id]).height} loading="lazy" /><span class="num">{String(i + 1).padStart(2, '0')}</span></a>
            <div class="body">
              <h3>{l.short}</h3>
              <p class="addr"><a href={directions(l)} rel="noopener">{l.street}, {l.city}</a></p>
              <p class="note">{l.note}</p>
              <dl>
                <div><dt>Hours</dt><dd>Tue to Sun, 11:30am to 9pm<br />Monday closed</dd></div>
                <div><dt>Phone</dt><dd><a href={`tel:${l.tel}`}>{l.phone}</a></dd></div>
              </dl>
              <div class="cta">
                <a class="pill" href={l.menu}><span>View Menu</span><span class="arrow">&rarr;</span></a>
                <a class="pill pill--ink" href={l.order} target="_blank" rel="noopener">Order Online</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sig" aria-label="Signature dishes">
    <div class="container">
      <div class="head" data-a>
        <p class="eyebrow">House favorites</p>
        <h2 class="h2">Signature Dishes</h2>
        <p class="sub">House craft chicken with hand made sauce, and the rolls that carry our name.</p>
      </div>
      <ul>
        {signature.map((d) => (
          <li data-a>
            <a href="#kitchens">
              <span class="art"><span class="tile"><img src={food(d.img).src} alt={d.name} width={food(d.img).width} height={food(d.img).height} loading="lazy" /></span><i class="tag">${d.price}</i></span>
              <b>{d.name}</b>
              <span class="line">{d.line}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band" aria-hidden="true">
    <div class="strip">{strip.map((s) => <span class="tile"><img src={food(s).src} alt="" width={food(s).width} height={food(s).height} loading="lazy" /></span>)}</div>
  </section>

  <section class="about on-dark">
    <div class="container wrap">
      <figure class="portrait" data-a>
        <span class="frame"><span class="tile"><img src={chef.src} alt="Chef Ji Young Lee" width={chef.width} height={chef.height} loading="lazy" /></span></span>
        <figcaption>Chef Ji Young Lee</figcaption>
      </figure>
      <div class="txt" data-a>
        <p class="eyebrow">{TAGLINE}</p>
        <h2 class="h2">By Chef Ji Young Lee</h2>
        <p class="text">Kitchen 121 has been cooking in Duluth since 2017, and now in Hamilton Mill too. Owner chef Ji Young Lee trained at Le Cordon Bleu College of Culinary Arts and worked at The Ritz-Carlton, Atlanta before opening Kitchen 121.</p>
        <ul class="facts">
          <li><b>Le Cordon Bleu</b><span>College of Culinary Arts</span></li>
          <li><b>2015 to 2016</b><span>The Ritz-Carlton, Atlanta</span></li>
          <li><b>2017 to present</b><span>Group 121, owner chef</span></li>
          <li><b>Top 100</b><span>Yelp Sushi Spots 2024</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="cater">
    <div class="container cin">
      <div data-a>
        <p class="eyebrow">Catering 121</p>
        <h2 class="h2">Feeding a crowd?</h2>
        <p class="text">Kitchen 121 also offers catering services. Whether you prefer boxes or trays, we have the perfectly-portioned catering option for your family or corporate event.</p>
        <a class="pill pill--white" href={u('catering/')}><span>See Catering</span><span class="arrow">&rarr;</span></a>
      </div>
      <div class="plat" data-a>
        <span class="tile"><img src={food('hm-all-star').src} alt="Chicken All Star platter with six flavors of signature chicken" width={food('hm-all-star').width} height={food('hm-all-star').height} loading="lazy" /></span>
        <p class="from"><span>Party platters from</span><b>${fromPrice}</b></p>
      </div>
    </div>
  </section>

  <section class="insta">
    <div class="container">
      <div class="head" data-a>
        <p class="eyebrow">Instagram</p>
        <h2 class="h2">Follow {INSTAGRAM_HANDLE}</h2>
      </div>
      <ul data-a>
        {insta.map((s) => <li><a class="tile" href={INSTAGRAM} rel="noopener" aria-label={`Kitchen 121 on Instagram (${INSTAGRAM_HANDLE})`}><img src={food(s).src} alt="" width={food(s).width} height={food(s).height} loading="lazy" /></a></li>)}
      </ul>
      <p class="more" data-a><a class="pill pill--ink" href={INSTAGRAM} rel="noopener"><span>Open Instagram</span><span class="arrow">&rarr;</span></a></p>
    </div>
  </section>
</Site>

<style>
  /* ---------- hero: copy on the left, a tilted wall of real dishes on the right ---------- */
  .hero { position: relative; display: flex; align-items: center; overflow: hidden; min-height: min(92svh, 860px); background: var(--ink); }
  .mosaic { position: absolute; top: 50%; right: -6vw; width: min(60vw, 900px); display: grid; grid-template-columns: 1fr 1fr; gap: 16px; transform: translateY(-50%) rotate(var(--tilt)); }
  .mosaic .col { display: grid; gap: 16px; align-content: center; }
  .mosaic .col--b { transform: translateY(9%); }
  .mosaic .tile { aspect-ratio: 4 / 3; border-radius: 26px; }
  .shade { position: absolute; inset: 0; pointer-events: none; background:
    linear-gradient(to bottom, rgb(20 20 20 / .75) 0, rgb(20 20 20 / .2) 120px, transparent 220px),
    linear-gradient(to right, var(--ink) 0, var(--ink) 30%, rgb(20 20 20 / .55) 50%, rgb(20 20 20 / .05) 78%); }
  .content { position: relative; z-index: 2; padding-block: 7rem 4rem; }
  .copy { max-width: 40rem; }
  h1 { margin: 1.1rem 0 1.5rem; font-size: clamp(3.4rem, 7.6vw, 6.8rem); line-height: .9; letter-spacing: .005em; }
  h1 .l { display: block; }
  h1 .block { margin-top: .14em; }
  h1 .block span { display: inline-block; white-space: nowrap; padding: .08em .24em .03em; margin-left: -.06em; background: var(--green); transform: rotate(-3deg); transform-origin: left center; box-shadow: 0 14px 40px rgb(0 0 0 / .35); }
  .lead { margin: 0 0 1.9rem; max-width: 28rem; font-size: 1.15rem; line-height: 1.5; color: #e2e2e2; }
  .cta { display: flex; flex-wrap: wrap; gap: .9rem; }
  @media (max-width: 860px) {
    .hero { align-items: flex-end; min-height: 100svh; }
    .mosaic { top: 4.5rem; right: -22vw; left: -22vw; width: auto; transform: rotate(var(--tilt)); gap: 10px; }
    .mosaic .col { gap: 10px; }
    .mosaic .tile { border-radius: 18px; }
    .shade { background:
      linear-gradient(to bottom, rgb(20 20 20 / .8) 0, rgb(20 20 20 / .15) 110px, transparent 200px),
      linear-gradient(to top, var(--ink) 0, var(--ink) 34%, rgb(20 20 20 / .7) 52%, transparent 78%); }
    .content { padding-block: 0 3rem; }
    .copy { margin-inline: auto; text-align: center; }
    h1 .block span { transform-origin: center; }
    .lead { margin-inline: auto; }
    .cta { justify-content: center; }
  }

  /* ---------- shared section heads ---------- */
  .head { text-align: center; max-width: 44rem; margin: 0 auto clamp(2rem, 4vw, 3.4rem); }
  .sub { margin: .7rem auto 0; max-width: 36rem; color: #5d5d5d; }

  /* ---------- location chooser ---------- */
  .kitchens { background: var(--paper); color: var(--ink); padding: clamp(56px, 8vw, 110px) 0; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3vw, 40px); }
  .kcard { background: #fff; border-radius: 30px; overflow: hidden; box-shadow: 0 10px 40px rgb(0 0 0 / .07); display: flex; flex-direction: column; }
  .kcard .art { position: relative; display: block; aspect-ratio: 16 / 8; background: #1b1b1b; border-radius: 30px 30px 0 0; }
  .kcard .art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 30px 30px 0 0; }
  .num { position: absolute; left: 1.4rem; bottom: -1.1rem; display: grid; place-items: center; width: 4.2rem; height: 3.2rem; background: var(--green); color: #fff; font-family: var(--display); font-weight: 800; font-size: 2rem; line-height: 1; padding-top: .15rem; transform: rotate(8deg); box-shadow: 0 10px 24px rgb(0 0 0 / .25); }
  .body { padding: clamp(1.8rem, 3vw, 2.6rem); padding-top: 2.2rem; display: flex; flex-direction: column; flex: 1; }
  .kcard h3 { font-size: clamp(2.6rem, 5vw, 4rem); margin-bottom: .5rem; }
  .addr { margin: 0; font-weight: 600; font-size: 1.05rem; }
  .addr a, dd a { color: inherit; text-decoration: none; border-bottom: 2px solid rgb(15 102 54 / .35); }
  .addr a:hover, dd a:hover { border-bottom-color: var(--green); color: var(--green); }
  .note { margin: .3rem 0 1.2rem; color: #666; font-size: .95rem; }
  dl { margin: 0 0 1.6rem; display: grid; grid-template-columns: 1.7fr 1fr; gap: 1rem; }
  dt { font-family: var(--display); font-weight: 700; font-size: 1.05rem; letter-spacing: .12em; text-transform: uppercase; color: var(--green); }
  dd { margin: .1rem 0 0; font-weight: 600; line-height: 1.45; }
  .kcard .cta { margin-top: auto; }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }
  @media (max-width: 420px) { dl { grid-template-columns: 1fr; } }

  /* ---------- signature dishes ---------- */
  .sig { background: var(--paper); color: var(--ink); padding: 0 0 clamp(64px, 9vw, 120px); text-align: center; }
  .sig ul { list-style: none; margin: 0 auto; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(36px, 5vw, 64px) 4%; }
  .sig li { flex: 0 1 29%; }
  .sig a { display: block; color: inherit; text-decoration: none; }
  .sig .art { position: relative; display: block; margin: 0 auto 1.3rem; width: 86%; }
  .sig .art::before { content: ''; position: absolute; inset: -6% -7%; background: var(--charcoal); border-radius: 30px; transform: rotate(-6deg); transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .sig li:nth-child(even) .art::before { background: var(--green); transform: rotate(6deg); }
  .sig a:hover .art::before { transform: rotate(0deg); }
  .sig .tile { position: relative; aspect-ratio: 4 / 3; transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .sig a:hover .tile { transform: scale(1.03); }
  .tag { position: absolute; z-index: 2; right: -4%; bottom: -8%; background: #fff; color: var(--green); font-family: var(--display); font-weight: 800; font-style: normal; font-size: 1.5rem; line-height: 1; padding: .5rem .9rem .4rem; border-radius: 999px; box-shadow: 0 8px 18px rgb(0 0 0 / .18); transform: rotate(5deg); }
  .sig b { display: block; font-family: var(--display); font-weight: 800; font-size: clamp(1.7rem, 2.6vw, 2.3rem); line-height: 1; text-transform: uppercase; letter-spacing: .02em; }
  .line { display: block; margin-top: .35rem; font-size: .92rem; color: #666; }
  @media (max-width: 860px) { .sig li { flex-basis: 44%; } .tag { font-size: 1.2rem; } }

  /* ---------- photo band: a tilted strip of dishes ---------- */
  .band { background: var(--ink); padding: clamp(34px, 5vw, 60px) 0; overflow: hidden; }
  .strip { display: flex; gap: 16px; width: max-content; margin-left: -6vw; transform: rotate(-2deg); }
  .strip .tile { width: clamp(180px, 22vw, 320px); aspect-ratio: 4 / 3; flex: none; }
  @media (prefers-reduced-motion: no-preference) {
    .strip { animation: drift 60s linear infinite alternate; }
    @keyframes drift { from { transform: rotate(-2deg) translateX(0); } to { transform: rotate(-2deg) translateX(-18vw); } }
  }

  /* ---------- chef ---------- */
  .about { background: var(--charcoal); padding: clamp(64px, 9vw, 120px) 0; }
  .wrap { display: grid; grid-template-columns: minmax(180px, 280px) 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .portrait { margin: 0; }
  .frame { position: relative; display: block; }
  .frame::before { content: ''; position: absolute; inset: -5% -7%; background: var(--green); border-radius: 30px; transform: rotate(7deg); }
  .portrait .tile { position: relative; aspect-ratio: 9 / 10; }
  .portrait figcaption { margin-top: 1.8rem; text-align: center; font-family: var(--display); font-weight: 700; font-size: 1.2rem; letter-spacing: .12em; text-transform: uppercase; color: #cfcfcf; }
  .about .text { margin: 1.1rem 0 0; max-width: 38rem; font-size: 1.08rem; color: #d6d6d6; }
  .facts { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .facts li { border-top: 3px solid var(--green); padding-top: .8rem; }
  .facts b { display: block; font-family: var(--display); font-weight: 800; font-size: 1.6rem; line-height: 1; text-transform: uppercase; }
  .facts span { display: block; margin-top: .3rem; font-size: .88rem; color: #bdbdbd; line-height: 1.35; }
  @media (max-width: 860px) { .wrap { grid-template-columns: 1fr; } .portrait { width: min(60%, 240px); margin: 0 auto 1rem; } .txt { text-align: center; } .about .text { margin-inline: auto; } .facts { grid-template-columns: 1fr 1fr; text-align: left; } }

  /* ---------- catering teaser: the one full-green moment ---------- */
  .cater { background: var(--green); color: #fff; padding: clamp(64px, 9vw, 120px) 0; overflow: hidden; }
  .cin { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .cater .eyebrow { color: #fff; opacity: .85; }
  .cater .text { margin: 1rem 0 1.8rem; max-width: 34rem; font-size: 1.08rem; color: #e9f3ec; }
  .plat { position: relative; justify-self: center; width: min(100%, 380px); }
  .plat .tile { aspect-ratio: 1; transform: rotate(5deg); border: 6px solid #fff; border-radius: 30px; }
  .from { position: absolute; left: -1.5rem; bottom: -1.2rem; margin: 0; display: grid; background: var(--ink); color: #fff; padding: .8rem 1.2rem .6rem; border-radius: 20px; transform: rotate(-4deg); box-shadow: 0 12px 30px rgb(0 0 0 / .3); }
  .from span { font-family: var(--display); font-weight: 700; font-size: 1rem; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); line-height: 1.1; }
  .from b { font-family: var(--display); font-weight: 800; font-size: 3rem; line-height: .95; }
  @media (max-width: 860px) { .cin { grid-template-columns: 1fr; } .plat { width: min(72%, 300px); margin-top: 1rem; } .from { left: -.8rem; } }

  /* ---------- instagram ---------- */
  .insta { background: var(--paper); color: var(--ink); padding: clamp(64px, 9vw, 120px) 0; }
  .insta ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; }
  .insta .tile { aspect-ratio: 1; box-shadow: none; }
  .insta .tile img { transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .insta .tile:hover img { transform: scale(1.07); }
  .more { text-align: center; margin: 2rem 0 0; }
  @media (max-width: 860px) { .insta ul { grid-template-columns: repeat(3, 1fr); gap: 10px; } }
</style>
