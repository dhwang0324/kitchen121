---
// One menu category, laid out like the printed menu: tilted green heading, a strip of that category's photos,
// then the items in two columns (one on phones) as plain rows with the price on the right.
import { food } from '../data/site';
import type { Section } from '../data/menu';
interface Props { section: Section; prefix: string }
const { section: s, prefix } = Astro.props;
const photos = (s.photos ?? []).slice(0, 3);
---
<section class="cat" id={`${prefix}-${s.id}`} data-cat>
  <header>
    <h2><span>{s.title}</span></h2>
    {(s.note || s.extra) && <p class="note">{s.note} {s.extra && <b>{s.extra}</b>}</p>}
  </header>
  {photos.length > 0 && (
    <div class="strip" data-n={photos.length}>
      {photos.map((p) => { const im = food(p.img); return <img src={im.src} alt={p.cap} title={p.cap} width={im.width} height={im.height} loading="lazy" />; })}
    </div>
  )}
  <ul class="list">
    {s.items.map((i) => (
      <li>
        <div class="row">
          <span class="n">{i.n}{i.raw && <span class="raw" title="Served undercooked or may contain raw ingredient">*</span>}{i.spicy && <span class="mark spicy">Spicy</span>}{i.v && <span class="mark" title="Marked V on our printed menu">V</span>}{i.g && <span class="mark" title="Marked G on our printed menu">G</span>}</span>
          <b>${i.p}</b>
        </div>
        {(i.d || i.serves) && <p class="d">{i.serves && <span class="serves">{i.serves}{i.d && '. '}</span>}{i.d}</p>}
      </li>
    ))}
  </ul>
</section>

<style>
  .cat { padding-top: clamp(2.6rem, 6vw, 4.2rem); }
  header { text-align: center; }
  h2 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
  h2 span { display: inline-block; padding: .16em .5em .07em; background: var(--green); color: #fff; transform: rotate(-1.5deg); }
  .note { margin: 1rem auto 0; max-width: 44rem; font-size: .95rem; color: #5f5f5f; }
  .note b { color: var(--green); font-weight: 600; white-space: nowrap; }
  .strip { display: flex; gap: 10px; margin-top: 1.6rem; }
  .strip img { flex: 1; min-width: 0; width: 0; height: clamp(96px, 15vw, 180px); object-fit: cover; border-radius: 14px; background: #eee; }
  .list { list-style: none; margin: 1.4rem 0 0; padding: 0; columns: 2; column-gap: clamp(2rem, 5vw, 4.5rem); }
  .list li { break-inside: avoid; padding: .8rem 0; border-bottom: 1px solid rgb(0 0 0 / .1); }
  .row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .n { font-weight: 600; font-size: 1.03rem; line-height: 1.3; }
  .raw { color: var(--green); margin-left: 1px; }
  .row b { font-family: var(--display); font-weight: 800; font-size: 1.5rem; line-height: 1; color: var(--green); }
  .d { margin: .2rem 0 0; padding-right: 3rem; font-size: .9rem; line-height: 1.45; color: #6b6b6b; }
  .serves { font-weight: 600; color: #444; }
  .mark { display: inline-block; margin-left: .4rem; padding: 0 .32rem; border: 1px solid #b9b9b9; border-radius: 4px; font-size: .64rem; font-weight: 700; letter-spacing: .06em; line-height: 1.5; color: #6b6b6b; text-transform: uppercase; vertical-align: 2px; }
  .mark.spicy { border-color: #d9a39f; color: #b3261e; }
  @media (max-width: 760px) { .list { columns: 1; } .d { padding-right: 1.5rem; } .strip { gap: 6px; } .strip img { border-radius: 10px; } }
</style>
