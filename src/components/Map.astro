---
// Google Maps embed (no API key needed), same as the Chicken 121 site.
interface Props { query: string; title: string }
const { query, title } = Astro.props;
const src = `https://www.google.com/maps?q=${encodeURIComponent(query)}&output=embed`;
---
<div class="map"><iframe src={src} title={title} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
<style>
  .map { width: 100%; aspect-ratio: 4 / 3; border-radius: 24px; overflow: hidden; background: #e8e4dc; box-shadow: 0 10px 40px rgb(0 0 0 / .12); }
  iframe { display: block; width: 100%; height: 100%; border: 0; }
</style>
