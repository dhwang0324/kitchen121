---
// Home. Blend of design concepts 1 (warm cream sections) and 4 (thin rules, open space), in Barlow Condensed + Barlow.
// Facts, prices and hours come from src/data/; photos are the restaurant's own (src/assets/home/: frames from their
// video and table-spread photo). Reviews are empty slots until the owner supplies real ones.
import Site from '../layouts/Site.astro';
import Fresh from '../assets/fresh-begins-here.svg';
import { u, LOCATIONS, HOURS, INSTAGRAM, INSTAGRAM_HANDLE, directions } from '../data/site';
import { MENUS } from '../data/menu';
import { BANNERS } from '../data/banners';
import { STOREFRONTS } from '../data/storefronts';
import { REVIEWS } from '../data/reviews';
import roll from '../assets/home/roll.webp';
import red from '../assets/home/red-pepper.webp';
import soy from '../assets/home/soy-garlic.webp';
import bowl from '../assets/home/bulgogi-bowl.webp';
import table from '../assets/home/table.webp';
import salad from '../assets/home/salad.webp';
import spread from '../assets/home/spread.webp';
const hero = BANNERS.home;
const all = [...MENUS.duluth, ...MENUS['hamilton-mill']];
const from = (ids: string[]) => Math.min(...all.filter((s) => ids.includes(s.id)).flatMap((s) => s.items.map((i) => i.p)));
const dishes = [
  { img: red, name: '121 Signature Chicken', note: 'A 1.5 lb chicken breast, fried crisp, with a hand-made sauce. Eight flavors.', price: from(['signature-chicken']) },
  { img: roll, name: '121 Rolls', note: 'The 121 special rolls, rainbow, caterpillar, spicy tuna and more.', price: from(['roll']) },
  { img: bowl, name: 'Bowls & Salads', note: 'Hot bowls, sushi and poke bowls, house salads.', price: from(['hot-bowl', 'sushi-bowl', 'salad-bowl', 'cool-salad']) },
];
const five = [
  { img: red, name: 'Red Pepper Chicken', note: '121 Signature Chicken', price: 17 },
  { img: soy, name: 'Oriental Soy Garlic', note: '121 Signature Chicken', price: 17 },
  { img: roll, name: '121 Rolls', note: 'Special and classic rolls', price: from(['roll']) },
  { img: bowl, name: 'Hot Bowls', note: 'Over seasoned rice, sunny side up', price: from(['hot-bowl']) },
  { img: salad, name: 'Crunch Chicken Salad', note: 'House salads and poke', price: from(['cool-salad', 'salad-bowl']) },
];
const insta = [soy, roll, spread, red, bowl, salad];
const Img = (i: ImageMetadata) => ({ src: i.src, width: i.width, height: i.height });
---
<Site title="Kitchen 121 | Fresh begins here" active="home">
  <section class="hero" aria-label="Welcome">
    <img class="photo" src={hero.src} srcset={hero.srcset} sizes="100vw" width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high" />
    <div class="shade"></div>
    <div class="container content">
      <div class="copy rise">
        <p class="hl">Since 2017 &middot; Duluth &amp; Hamilton Mill</p>
        <h1 class="script"><span class="sr-only">Fresh Begins Here!</span><Fresh aria-hidden="true" /></h1>
        <p class="lead">Signature chicken, sushi rolls and bowls by Chef Ji Young Lee.</p>
        <div class="cta">
          <a class="b1" href={u('locations/')} data-order>Order Now</a>
          <a class="b2" href={u('menu/')}>See the Menu</a>
        </div>
      </div>
    </div>
  </section>

  <section class="statement">
    <div class="container"><p>Chef-crafted Korean fried chicken, sushi and bowls. <span>Since 2017.</span></p></div>
  </section>

  <section class="dishes">
    <div class="container">
      <header class="sh"><h2>Signature dishes</h2><a class="tl" href={u('menu/')}>Full menu &rarr;</a></header>
      <div class="f2">
        <a class="big" href={u('menu/')}><img {...Img(dishes[0].img)} alt={dishes[0].name} loading="lazy" /><div class="cap"><span class="from">From ${dishes[0].price}</span><h3>{dishes[0].name}</h3><p>{dishes[0].note}</p></div></a>
        {dishes.slice(1).map((d) => (<a class="sm" href={u('menu/')}><img {...Img(d.img)} alt={d.name} loading="lazy" /><div class="cap"><h3>{d.name}</h3><span>from ${d.price}</span></div></a>))}
      </div>
    </div>
    <div class="rail" aria-label="Signature dishes">
      {five.map((d) => (<a class="card" href={u('menu/')}><img {...Img(d.img)} alt={d.name} loading="lazy" /><div class="ov"><span>{d.note}</span><h3>{d.name}</h3><b>${d.price}</b></div></a>))}
    </div>
  </section>

  <section class="chef">
    <figure class="ph"><img {...Img(soy)} alt="Soy garlic fried chicken topped with crispy noodles and scallion" loading="lazy" /></figure>
    <div class="txt">
      <p class="label">Chef-crafted kitchen</p>
      <h2>Chef-crafted, since 2017</h2>
      <p class="body">Every plate at Kitchen 121 is made by hand by Chef Ji Young Lee and the kitchen team, from the hand-made sauces on our chicken to the rolls made to order.</p>
      <ul class="feats">
        <li><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M13 3h6v5l3 4v15a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2V12l3-4z M10 17h12"/></svg><div><b>House-made sauces</b><span>Soy garlic, red pepper, sweet onion and more, made in our kitchen.</span></div></li>
        <li><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="17" r="11"/><path d="M16 10v7l5 3 M12 3h8"/></svg><div><b>Made to order</b><span>Chicken fried and rolls rolled when you order.</span></div></li>
        <li><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 29s-9-8-9-15a9 9 0 0 1 18 0c0 7-9 15-9 15z"/><circle cx="16" cy="14" r="3.2"/></svg><div><b>Two kitchens</b><span>Duluth since 2017, and now Hamilton Mill.</span></div></li>
      </ul>
      <p class="cred">Le Cordon Bleu trained &middot; formerly The Ritz-Carlton, Atlanta &middot; owner chef since 2017</p>
    </div>
  </section>

  <section class="reviews" aria-label="Guest reviews">
    <div class="container"><header class="sh"><h2>What our guests say</h2><span class="hint"><span class="stars" aria-hidden="true">★★★★★</span> Google reviews</span></header></div>
    <div class="strip">
      <ul class="track">
        {[0, 1].map((copy) => REVIEWS.map((r) => (
          <li aria-hidden={copy ? 'true' : undefined}>
            <span class="stars" aria-label={copy ? undefined : '5 out of 5 stars'}>★★★★★</span>
            <p>“{r.text}”</p>
            <cite>{r.name} &middot; Google</cite>
          </li>
        )))}
      </ul>
    </div>
  </section>

  <section class="visit" id="kitchens">
    <div class="container">
      <header class="sh"><h2>Visit us</h2><span class="hrs">{HOURS[1].days} {HOURS[1].time} &middot; {HOURS[0].days} {HOURS[0].time.toLowerCase()}</span></header>
      <div class="v2">
        {LOCATIONS.map((l) => (
          <article>
            <img {...Img(STOREFRONTS[l.id].img)} alt={STOREFRONTS[l.id].alt} style={`object-position:${STOREFRONTS[l.id].position}`} loading="lazy" />
            <div class="vb">
              <h3>{l.short}</h3>
              <p>{l.street}<br />{l.city}</p>
              <p class="tel"><a href={`tel:${l.tel}`}>{l.phone}</a></p>
              <div class="acts"><a class="pill pill--sm" href={l.order.clover} data-order={l.id}>Order</a><a class="tl" href={l.menu}>Menu</a><a class="tl" href={directions(l)} rel="noopener">Directions</a></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="insta">
    <div class="container">
      <header class="sh"><h2>On Instagram</h2><a class="tl" href={INSTAGRAM} rel="noopener">{INSTAGRAM_HANDLE} &rarr;</a></header>
      <div class="ig">{insta.map((i) => <a href={INSTAGRAM} rel="noopener" aria-label={`Kitchen 121 on Instagram (${INSTAGRAM_HANDLE})`}><img {...Img(i)} alt="" loading="lazy" /></a>)}</div>
    </div>
  </section>
</Site>

<style>
  /* ---------- hero: the big full-width photo with calm, quiet type.
     Desktop: small type tucked in the bottom-left corner, light shade, text links.
     Phones: an even, soft dim with everything centered and two small square buttons. ---------- */
  .hero { position: relative; display: flex; overflow: hidden; min-height: min(84svh, 820px); background: #1b1a18; color: #fff; }
  .photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% 52%; display: block; }
  .shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(to top right, rgb(18 17 15 / .7) 0, rgb(18 17 15 / .25) 40%, transparent 65%); }
  .content { position: relative; z-index: 2; display: flex; width: 100%; align-items: flex-end; padding-bottom: clamp(2.4rem, 5vw, 4rem); }
  .copy { display: grid; gap: 1rem; max-width: 26rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  h1.script { order: -1; width: min(70vw, 25rem); line-height: 0; color: inherit; } h1.script svg { display: block; width: 100%; height: auto; }
  .hl { margin: 0; font-size: .82rem; font-weight: 500; letter-spacing: .28em; text-transform: uppercase; color: rgb(255 255 255 / .75); }
  .lead { margin: 0; font-size: 1rem; line-height: 1.55; color: rgb(255 255 255 / .85); }
  .cta { display: flex; flex-wrap: wrap; gap: .8rem; }
  .b1, .b2 { display: inline-flex; align-items: center; padding: .2rem 0; margin-right: 1.2rem; color: #fff; border-bottom: 1px solid rgb(255 255 255 / .6); font-size: .95rem; font-weight: 600; letter-spacing: .06em; text-decoration: none; transition: background-color .3s, color .3s, border-color .3s; }
  .b1::after, .b2::after { content: ' \2192'; margin-left: .35rem; }
  .b1:hover, .b2:hover { border-bottom-color: #fff; }
  @media (max-width: 860px) {
    .hero { min-height: 78svh; }
    .photo { object-position: 62% 50%; }
    .shade { background: radial-gradient(ellipse at 50% 50%, rgb(18 17 15 / .58) 0, rgb(18 17 15 / .5) 45%, rgb(18 17 15 / .62) 85%); }
    .content { align-items: center; justify-content: center; padding-block: 3rem; text-align: center; }
    .copy { max-width: 34rem; justify-items: center; gap: 1.2rem; }
    h1.script { order: 0; width: min(86vw, 26rem); }
    .hl { color: rgb(255 255 255 / .82); }
    .lead { color: #fff; text-shadow: 0 1px 12px rgb(0 0 0 / .5); padding-top: 1.1rem; border-top: 1px solid rgb(255 255 255 / .35); font-size: 1.05rem; }
    .cta { justify-content: center; }
    .b1, .b2 { margin: 0; padding: .75rem 1.3rem .7rem; border-radius: 3px; border-bottom: 0; }
    .b1::after, .b2::after { content: none; }
    .b1 { background: #fff; color: var(--body-ink); } .b1:hover { background: var(--cream); }
    .b2 { border: 1px solid rgb(255 255 255 / .7); } .b2:hover { background: rgb(255 255 255 / .12); }
  }

  /* ---------- shared: cream paper, thin rules ---------- */
  .statement, .chef, .dishes, .reviews, .visit, .insta { --cream: #f6f1e8; --rule: #d8cfbe; background: var(--cream); color: #2a2622; }
  section h2 { font-size: clamp(2.6rem, 5vw, 4rem); line-height: .95; }
  .label { margin: 0 0 .6rem; font-family: var(--display); font-weight: 700; font-size: 1rem; letter-spacing: .2em; text-transform: uppercase; color: var(--green); }
  .tl { color: inherit; font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; text-decoration-color: var(--green); white-space: nowrap; }
  .tl:hover { color: var(--green); }
  .sh { display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; padding-bottom: 1.1rem; margin-bottom: clamp(1.6rem, 3vw, 2.4rem); border-bottom: 1px solid var(--rule); }
  img { display: block; width: 100%; height: auto; object-fit: cover; }

  .statement { padding: clamp(40px, 6vw, 72px) 0; text-align: center; }
  .statement .container { display: flex; align-items: center; gap: 2rem; }
  .statement .container::before, .statement .container::after { content: ''; flex: 1; height: 1px; background: var(--rule); }
  .statement p { margin: 0; max-width: 40rem; font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.5; color: #4a443c; }
  .statement span { color: var(--green); font-weight: 600; }


  /* Chef-crafted: the photo fills the left half edge to edge, text on the right. */
  .chef { display: grid; grid-template-columns: 1fr 1fr; min-height: 540px; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .ph { margin: 0; } .ph img { height: 100%; }
  .chef .txt { align-self: center; max-width: 40rem; padding: clamp(40px, 6vw, 80px) clamp(24px, 6vw, 88px); }
  .chef h2 { font-size: clamp(2.4rem, 3.6vw, 3.2rem); }
  .chef .body { margin: 1rem 0 0; font-size: 1.05rem; line-height: 1.65; color: #5d564c; }
  .feats { list-style: none; margin: 1.6rem 0 0; padding: 0; }
  .feats li { display: flex; gap: 1rem; align-items: flex-start; padding: .9rem 0; border-top: 1px solid var(--rule); }
  .feats li div { display: grid; gap: .2rem; }
  .feats svg { flex: none; width: 1.8rem; height: 1.8rem; fill: none; stroke: var(--green); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .feats b { font-family: var(--display); font-weight: 700; font-size: 1.1rem; letter-spacing: .08em; text-transform: uppercase; }
  .feats span { font-size: .92rem; line-height: 1.5; color: #5d564c; }
  .cred { margin: 1.4rem 0 0; font-size: .85rem; letter-spacing: .04em; color: #8a8070; }
  @media (max-width: 860px) { .chef { grid-template-columns: 1fr; min-height: 0; } .ph img { aspect-ratio: 4 / 3; } }

  .dishes { padding: 0 0 clamp(48px, 7vw, 80px); }
  /* Desktop: one large feature photo + two smaller. Phones: a swipeable row of five tall cards. */
  .f2 { display: grid; grid-template-columns: 1.6fr 1fr; grid-template-rows: 1fr 1fr; gap: 14px; height: clamp(420px, 42vw, 600px); }
  .f2 a { position: relative; display: block; overflow: hidden; border-radius: 6px; color: #fff; text-decoration: none; }
  .f2 img { height: 100%; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .f2 a:hover img { transform: scale(1.04); }
  .big { grid-row: span 2; }
  .cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 1.6rem; background: linear-gradient(to top, rgb(18 17 15 / .75), transparent); }
  .big .cap h3 { font-size: clamp(2rem, 3vw, 2.8rem); }
  .big .cap p { margin: .4rem 0 0; max-width: 26rem; color: rgb(255 255 255 / .85); }
  .from { font-family: var(--display); font-weight: 700; font-size: .95rem; letter-spacing: .2em; text-transform: uppercase; color: #cfe9d8; }
  .sm .cap { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 1.1rem 1.2rem; }
  .sm .cap h3 { font-size: 1.6rem; } .sm .cap span { font-weight: 600; white-space: nowrap; }
  .rail { display: none; }
  @media (max-width: 860px) {
    .f2 { display: none; }
    .rail { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 1.25rem 6px; scroll-padding-inline: 1.25rem; scrollbar-width: none; }
    .rail::-webkit-scrollbar { display: none; }
    .card { position: relative; flex: none; width: 72vw; max-width: 300px; aspect-ratio: 3 / 4; border-radius: 6px; overflow: hidden; scroll-snap-align: start; color: #fff; text-decoration: none; }
    .card img { height: 100%; }
    .ov { position: absolute; inset: auto 0 0 0; padding: 1.1rem; background: linear-gradient(to top, rgb(18 17 15 / .8), transparent); }
    .ov span { font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: rgb(255 255 255 / .8); }
    .ov h3 { margin-top: .2rem; font-size: 1.5rem; }
    .ov b { display: block; margin-top: .3rem; font-family: var(--display); font-size: 1.15rem; color: #cfe9d8; }
  }
  /* Reviews: a slow, endless strip of review cards (pauses on hover; still and scrollable with reduced motion). */
  .reviews { padding: clamp(56px, 8vw, 100px) 0; border-bottom: 1px solid var(--rule); overflow: hidden; }
  .hint { color: #5d564c; font-size: .95rem; }
  .strip { mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent); }
  .track { list-style: none; margin: 0; padding: 0 0 4px 4vw; display: flex; gap: 18px; width: max-content; }
  .track li { width: 360px; padding: 1.5rem 1.7rem; background: #fff; border: 1px solid var(--rule); border-radius: 6px; display: grid; gap: .7rem; align-content: start; }
  .track p { margin: 0; font-size: 1.02rem; line-height: 1.55; color: #3f3a33; }
  .track cite { font-style: normal; font-family: var(--display); font-weight: 600; font-size: .9rem; letter-spacing: .1em; text-transform: uppercase; color: #9b9283; }
  @media (prefers-reduced-motion: no-preference) {
    .track { animation: rv-slide 120s linear infinite; }
    .strip:hover .track { animation-play-state: paused; }
    @keyframes rv-slide { to { transform: translateX(-50%); } }
  }
  @media (prefers-reduced-motion: reduce) { .strip { overflow-x: auto; } .track li[aria-hidden="true"] { display: none; } }
  @media (max-width: 860px) { .track li { width: 78vw; } }
  .stars { color: #c99a2e; letter-spacing: .2em; font-size: .95rem; }

  .visit { padding: clamp(64px, 9vw, 120px) 0; }
  .hrs { font-size: 1rem; color: #5d564c; }
  .v2 { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3vw, 40px); }
  .v2 article { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; align-items: center; }
  .v2 img { aspect-ratio: 4 / 3; border-radius: 4px; height: 100%; }
  .vb h3 { font-size: 2.3rem; }
  .vb p { margin: .5rem 0 0; color: #4a443c; line-height: 1.5; }
  .tel a { color: inherit; font-weight: 600; text-decoration: none; }
  .acts { display: flex; flex-wrap: wrap; align-items: center; gap: 1.1rem; margin-top: 1.2rem; }

  .insta { padding: 0 0 clamp(64px, 9vw, 120px); }
  .ig { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }
  .ig a { display: block; overflow: hidden; border-radius: 4px; }
  .ig img { aspect-ratio: 1; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .ig a:hover img { transform: scale(1.06); }

  @media (max-width: 900px) {
    .v2 { grid-template-columns: 1fr; }
    .ig { grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .statement .container::before, .statement .container::after { display: none; }
  }
  @media (max-width: 520px) { .v2 article { grid-template-columns: 1fr; } }
</style>
