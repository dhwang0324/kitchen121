---
// One menu category, laid out like the printed menu: heading with a thin rule, the restaurant's own photos where we
// have one for the category, then the items in two columns (one on phones) with the price on the right.
import type { Section } from '../data/menu';
import red from '../assets/home/red-pepper.webp';
import soy from '../assets/home/soy-garlic.webp';
import roll from '../assets/home/roll.webp';
import bowl from '../assets/home/bulgogi-bowl.webp';
import salad from '../assets/home/salad.webp';
import table from '../assets/home/table.webp';
import bulgogiSalad from '../assets/home/bulgogi-salad-overhead.webp';
import rollMenu from '../assets/home/roll-menu.webp';
import rollMenuPhone from '../assets/home/roll-menu-phone.webp';
interface Props { section: Section; prefix: string }
const { section: s, prefix } = Astro.props;
// phone: an optional different photo for phone-width screens (same strip slot).
const REAL: Record<string, { img: ImageMetadata; cap: string; phone?: ImageMetadata }[]> = {
  'signature-chicken': [{ img: red, cap: 'Red Pepper Chicken' }, { img: soy, cap: 'Oriental Soy Garlic Chicken' }],
  'roll': [{ img: rollMenu, phone: rollMenuPhone, cap: 'Crunch roll with orange tobiko' }],
  'hot-bowl': [{ img: bowl, cap: 'Bulgogi bowl' }],
  'salad-bowl': [{ img: bulgogiSalad, cap: 'Grilled Bulgogi Salad' }],
  'cool-salad': [{ img: salad, cap: 'Crunch chicken salad' }],
  'party-platter': [{ img: table, cap: 'A Kitchen 121 table spread' }],
};
const photos = REAL[s.id] ?? [];
---
<section class="cat" id={`${prefix}-${s.id}`} data-cat>
  <header>
    <h2><span>{s.title}</span></h2>
    {(s.note || s.extra) && <p class="note">{s.note} {s.extra && <b>{s.extra}</b>}</p>}
  </header>
  {photos.length > 0 && (
    <div class="strip" data-n={photos.length}>
      {photos.map((p) => (<picture>{p.phone && <source media="(max-width: 760px)" srcset={p.phone.src} />}<img src={p.img.src} alt={p.cap} title={p.cap} width={p.img.width} height={p.img.height} loading="lazy" /></picture>))}
    </div>
  )}
  <ul class="list">
    {s.items.map((i) => (
      <li>
        <div class="row">
          <span class="n">{i.n}{i.raw && <span class="raw" title="Served undercooked or may contain raw ingredient">*</span>}{i.spicy && <span class="mark spicy">Spicy</span>}{i.v && <span class="mark" title="Marked V on our printed menu">V</span>}{i.g && <span class="mark" title="Marked G on our printed menu">G</span>}</span>
          <b>${i.p}</b>
        </div>
        {(i.d || i.serves) && <p class="d">{i.serves && <span class="serves">{i.serves}{i.d && '. '}</span>}{i.d}</p>}
      </li>
    ))}
  </ul>
</section>

<style>
  .cat { padding-top: clamp(2.6rem, 6vw, 4.2rem); }
  header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .4rem 2rem; padding-bottom: .9rem; border-bottom: 1px solid var(--rule); }
  h2 { font-size: clamp(2.2rem, 4.4vw, 3.2rem); }
  h2 span { display: inline; }
  .note { margin: 0; max-width: 34rem; font-size: .92rem; color: var(--muted); }
  .note b { color: var(--green); font-weight: 600; white-space: nowrap; }
  .strip { display: flex; gap: 10px; margin-top: 1.6rem; }
  .strip picture { display: contents; }
  .strip img { flex: 1; min-width: 0; width: 0; height: clamp(120px, 18vw, 220px); object-fit: cover; border-radius: 4px; background: #eee; }
  .list { list-style: none; margin: 1.4rem 0 0; padding: 0; columns: 2; column-gap: clamp(2rem, 5vw, 4.5rem); }
  .list li { break-inside: avoid; padding: .8rem 0; border-bottom: 1px solid var(--rule); }
  .row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .n { font-weight: 600; font-size: 1.03rem; line-height: 1.3; }
  .raw { color: var(--green); margin-left: 1px; }
  .row b { font-family: var(--display); font-weight: 800; font-size: 1.5rem; line-height: 1; color: var(--green); }
  .d { margin: .2rem 0 0; padding-right: 3rem; font-size: .9rem; line-height: 1.45; color: #6b6b6b; }
  .serves { font-weight: 600; color: #444; }
  .mark { display: inline-block; margin-left: .4rem; padding: 0 .32rem; border: 1px solid #b9b9b9; border-radius: 4px; font-size: .64rem; font-weight: 700; letter-spacing: .06em; line-height: 1.5; color: #6b6b6b; text-transform: uppercase; vertical-align: 2px; }
  .mark.spicy { border-color: #d9a39f; color: #b3261e; }
  @media (max-width: 760px) { .list { columns: 1; } .d { padding-right: 1.5rem; } .strip { gap: 6px; } .strip img { border-radius: 4px; } }
</style>
