---
// A location's full menu. Both locations share this page; the content comes from src/data/menu.ts.
import Site from '../layouts/Site.astro';
import PageHero from './PageHero.astro';
import MenuPanel from './MenuPanel.astro';
import { LOCATIONS, loc, address, HOURS, type LocId } from '../data/site';
import { MENUS, RAW_NOTICE } from '../data/menu';
interface Props { id: LocId }
const { id } = Astro.props;
const here = loc(id);
const other = LOCATIONS.find((l) => l.id !== id)!;
const sections = MENUS[id];
const heroPhotos: Record<LocId, [string, string]> = { duluth: ['hot-bulgogi', 'chicken-soy-garlic'], 'hamilton-mill': ['hm-all-star', 'c-roll'] };
---
<Site title={`${here.short} Menu | Kitchen 121`} description={`Menu for ${here.name}: signature chicken, sushi rolls, bowls and party platters. ${address(here)}.`} active={id}>
  <PageHero eyebrow={here.name} title={`${here.short} Menu`} lead={`${address(here)}. ${HOURS[1].days} ${HOURS[1].time}, ${HOURS[0].days} ${HOURS[0].time.toLowerCase()}.`} photos={heroPhotos[id]}>
    <a class="pill" href={here.order} target="_blank" rel="noopener"><span>Order Online</span><span class="arrow">&rarr;</span></a>
    <a class="pill pill--ghost" href={other.menu}>{other.short} Menu</a>
  </PageHero>

  <div class="menu" id="menu">
    <div class="cats">
      <div class="container scroller" role="tablist" aria-label="Menu categories">
        {sections.map((s, i) => <a class="tab" role="tab" href={`#${s.id}`} id={`tab-${s.id}`} aria-controls={s.id} aria-selected={i === 0 ? 'true' : 'false'} data-id={s.id}>{s.title.replace(/^121 /, '')}</a>)}
      </div>
    </div>
    <div class="container stack">
      {sections.map((s) => <MenuPanel section={s} />)}
      <p class="fine"><b>*</b> {RAW_NOTICE}</p>
    </div>
  </div>

  <section class="order on-dark">
    <div class="container">
      <p class="eyebrow">{here.name}</p>
      <h2 class="h2">Ready to order?</h2>
      <div class="cta">
        <a class="pill" href={here.order} target="_blank" rel="noopener"><span>Order Online</span><span class="arrow">&rarr;</span></a>
        <a class="pill pill--ghost" href={`tel:${here.tel}`}>Call {here.phone}</a>
      </div>
    </div>
  </section>
</Site>

<style>
  .menu { background: var(--paper); color: var(--ink); padding-bottom: clamp(56px, 8vw, 96px); scroll-margin-top: 4.5rem; }
  .cats { position: sticky; top: 4.6rem; z-index: 40; background: var(--paper); border-bottom: 1px solid rgb(0 0 0 / .1); }
  .scroller { display: flex; gap: .5rem; overflow-x: auto; padding-block: .8rem; scrollbar-width: none; }
  .scroller::-webkit-scrollbar { display: none; }
  .tab { flex: none; padding: .5rem 1.15rem .4rem; border-radius: 9999px; border: 2px solid var(--ink); color: var(--ink); text-decoration: none; font-family: var(--display); font-weight: 800; font-size: 1.15rem; letter-spacing: .08em; text-transform: uppercase; line-height: 1.1; transition: background-color .2s, color .2s, border-color .2s; }
  .tab:hover { background: rgb(20 20 20 / .08); }
  .tab[aria-selected="true"] { background: var(--green); border-color: var(--green); color: #fff; }
  .stack { display: grid; gap: clamp(20px, 3vw, 36px); padding-top: clamp(24px, 4vw, 44px); }
  .fine { margin: 0; font-size: .82rem; line-height: 1.5; color: #6b6b6b; }
  .fine b { color: var(--green); }
  .order { text-align: center; background: var(--ink); padding: clamp(56px, 8vw, 104px) 0; }
  .order h2 { margin-bottom: 1.6rem; }
  .order .cta { display: flex; flex-wrap: wrap; justify-content: center; gap: .9rem; }
</style>

<script>
  // Tabs: one category at a time. Without JavaScript every category stays visible and the tabs act as jump links.
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const menu = document.getElementById('menu');
  const show = (id: string, scroll = false) => {
    if (!panels.some((p) => p.dataset.panel === id)) return;
    tabs.forEach((t) => { const on = t.dataset.id === id; t.setAttribute('aria-selected', String(on)); if (on) { const sc = t.parentElement!; sc.scrollTo({ left: t.offsetLeft - (sc.clientWidth - t.offsetWidth) / 2 }); } });
    panels.forEach((p) => { p.hidden = p.dataset.panel !== id; });
    if (scroll && menu && menu.getBoundingClientRect().top < 0) menu.scrollIntoView();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', (e) => { e.preventDefault(); show(t.dataset.id!, true); history.replaceState(null, '', `#${t.dataset.id}`); });
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      next.focus(); show(next.dataset.id!);
    });
  });
  show(location.hash.slice(1) && panels.some((p) => p.dataset.panel === location.hash.slice(1)) ? location.hash.slice(1) : tabs[0].dataset.id!);
</script>
