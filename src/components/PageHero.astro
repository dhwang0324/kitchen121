---
// Header for the inner pages: title on the left, the page's photo in an inset frame on the right, on cream paper.
import { BANNERS, type BannerId } from '../data/banners';
interface Props { eyebrow?: string; title: string; lead?: string; banner: BannerId; position?: string }
const { eyebrow, title, lead, banner, position = '70% 50%' } = Astro.props;
const b = BANNERS[banner];
---
<section class="phero">
  <div class="container grid">
    <div class="in rise">
      {eyebrow && <p class="k-label">{eyebrow}</p>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <div class="cta"><slot /></div>
    </div>
    <figure class="frame"><img src={b.src} srcset={b.srcset} sizes="(max-width: 860px) 100vw, 55vw" width={b.width} height={b.height} alt={b.alt} style={`object-position:${position}`} fetchpriority="high" /></figure>
  </div>
</section>

<style>
  .phero { background: var(--cream); color: var(--body-ink); padding: clamp(32px, 5vw, 64px) 0 clamp(28px, 4vw, 48px); }
  .grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(1.5rem, 5vw, 4rem); align-items: center; padding-bottom: clamp(28px, 4vw, 48px); border-bottom: 1px solid var(--rule); }
  h1 { font-size: clamp(3rem, 6vw, 5rem); line-height: 1; }
  .lead { margin: 1rem 0 0; max-width: 30rem; font-size: 1.08rem; line-height: 1.55; color: var(--muted); }
  .cta { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.4rem; }
  .cta:empty { display: none; }
  .frame { margin: 0; border-radius: 6px; overflow: hidden; background: #ddd; }
  .frame img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } .frame { order: -1; } }
</style>
