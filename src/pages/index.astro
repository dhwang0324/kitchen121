---
// Home. Blend of design concepts 1 (warm cream sections) and 4 (thin rules, open space), in Barlow Condensed + Barlow.
// Facts, prices and hours come from src/data/; photos are the restaurant's own (src/assets/home/: frames from their
// video and table-spread photo). Reviews are empty slots until the owner supplies real ones.
import Site from '../layouts/Site.astro';
import Fresh from '../assets/fresh-begins-here.svg';
import { u, LOCATIONS, HOURS, INSTAGRAM, INSTAGRAM_HANDLE, directions } from '../data/site';
import { MENUS } from '../data/menu';
import { BANNERS } from '../data/banners';
import { STOREFRONTS } from '../data/storefronts';
import roll from '../assets/home/roll.webp';
import red from '../assets/home/red-pepper.webp';
import soy from '../assets/home/soy-garlic.webp';
import bowl from '../assets/home/bulgogi-bowl.webp';
import table from '../assets/home/table.webp';
import salad from '../assets/home/salad.webp';
import spread from '../assets/home/spread.webp';
const hero = BANNERS.home;
const all = [...MENUS.duluth, ...MENUS['hamilton-mill']];
const from = (ids: string[]) => Math.min(...all.filter((s) => ids.includes(s.id)).flatMap((s) => s.items.map((i) => i.p)));
const dishes = [
  { img: red, name: '121 Signature Chicken', note: 'A 1.5 lb chicken breast, fried crisp, with a hand-made sauce. Eight flavors.', price: from(['signature-chicken']) },
  { img: roll, name: '121 Rolls', note: 'The 121 special rolls, rainbow, caterpillar, spicy tuna and more.', price: from(['roll']) },
  { img: bowl, name: 'Bowls & Salads', note: 'Hot bowls, sushi and poke bowls, house salads.', price: from(['hot-bowl', 'sushi-bowl', 'salad-bowl', 'cool-salad']) },
];
const insta = [soy, roll, spread, red, bowl, salad];
const Img = (i: ImageMetadata) => ({ src: i.src, width: i.width, height: i.height });
---
<Site title="Kitchen 121 | Fresh begins here" active="home">
  <section class="hero" aria-label="Welcome" data-v="1">
    <script is:inline>try { var v = new URLSearchParams(location.search).get('hero'); if (v) document.currentScript.parentElement.dataset.v = v; } catch (e) {}</script>
    <img class="photo" src={hero.src} srcset={hero.srcset} sizes="100vw" width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high" />
    <div class="shade"></div>
    <div class="container content">
      <div class="copy rise">
        <p class="hl">Since 2017 &middot; Duluth &amp; Hamilton Mill</p>
        <h1 class="script"><span class="sr-only">Fresh Begins Here!</span><Fresh aria-hidden="true" /></h1>
        <p class="lead">Signature chicken, sushi rolls and bowls by Chef Ji Young Lee.</p>
        <div class="cta">
          <a class="b1" href={u('locations/')} data-order>Order Now</a>
          <a class="b2" href={u('menu/')}>See the Menu</a>
        </div>
      </div>
    </div>
  </section>

  <section class="statement">
    <div class="container"><p>Chef-crafted Korean fried chicken, sushi and bowls. <span>Since 2017.</span></p></div>
  </section>

  <section class="dishes">
    <div class="container">
      <header class="sh"><h2>Signature dishes</h2><a class="tl" href={u('menu/')}>Full menu &rarr;</a></header>
      <div class="d3">
        {dishes.map((d) => (
          <article>
            <a href={u('menu/')} class="dimg"><img {...Img(d.img)} alt={d.name} loading="lazy" /></a>
            <div class="dr"><h3>{d.name}</h3><b>from ${d.price}</b></div>
            <p>{d.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="chef">
    <div class="container grid">
      <div class="txt">
        <p class="label">Chef-crafted kitchen</p>
        <h2>Chef-crafted, since 2017</h2>
        <p class="body">Every plate at Kitchen 121 is made by hand by Chef Ji Young Lee and the kitchen team, from the hand-made sauces on our chicken to the rolls made to order. Le Cordon Bleu trained, and formerly of The Ritz-Carlton, Atlanta.</p>
        <ul class="feats">
          <li><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M13 3h6v5l3 4v15a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2V12l3-4z M10 17h12"/></svg><b>House-made sauces</b></li>
          <li><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="17" r="11"/><path d="M16 10v7l5 3 M12 3h8"/></svg><b>Made to order</b></li>
          <li><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 29s-9-8-9-15a9 9 0 0 1 18 0c0 7-9 15-9 15z"/><circle cx="16" cy="14" r="3.2"/></svg><b>Two kitchens</b></li>
        </ul>
      </div>
      <figure class="ph"><img {...Img(soy)} alt="Soy garlic fried chicken topped with crispy noodles and scallion" loading="lazy" /></figure>
    </div>
  </section>

  <section class="reviews">
    <div class="container rg">
      <h2 class="side">What our<br />guests say</h2>
      <div class="r3">
        {[1, 2, 3].map(() => (
          <blockquote>
            <span class="stars" aria-hidden="true">★★★★★</span>
            <p>[Customer review to be added]</p>
            <cite>[Name, Google or Yelp]</cite>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="visit" id="kitchens">
    <div class="container">
      <header class="sh"><h2>Visit us</h2><span class="hrs">{HOURS[1].days} {HOURS[1].time} &middot; {HOURS[0].days} {HOURS[0].time.toLowerCase()}</span></header>
      <div class="v2">
        {LOCATIONS.map((l) => (
          <article>
            <img {...Img(STOREFRONTS[l.id].img)} alt={STOREFRONTS[l.id].alt} style={`object-position:${STOREFRONTS[l.id].position}`} loading="lazy" />
            <div class="vb">
              <h3>{l.short}</h3>
              <p>{l.street}<br />{l.city}</p>
              <p class="tel"><a href={`tel:${l.tel}`}>{l.phone}</a></p>
              <div class="acts"><a class="pill pill--sm" href={l.order.clover} data-order={l.id}>Order</a><a class="tl" href={l.menu}>Menu</a><a class="tl" href={directions(l)} rel="noopener">Directions</a></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="insta">
    <div class="container">
      <header class="sh"><h2>On Instagram</h2><a class="tl" href={INSTAGRAM} rel="noopener">{INSTAGRAM_HANDLE} &rarr;</a></header>
      <div class="ig">{insta.map((i) => <a href={INSTAGRAM} rel="noopener" aria-label={`Kitchen 121 on Instagram (${INSTAGRAM_HANDLE})`}><img {...Img(i)} alt="" loading="lazy" /></a>)}</div>
    </div>
  </section>
</Site>

<style>
  /* ---------- hero: the big full-width photo with calm, quiet type (three treatments, data-v) ---------- */
  .hero { position: relative; display: flex; overflow: hidden; min-height: min(84svh, 820px); background: #1b1a18; color: #fff; }
  .photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% 52%; display: block; }
  .shade { position: absolute; inset: 0; pointer-events: none; }
  .content { position: relative; z-index: 2; display: flex; width: 100%; }
  .copy { max-width: 30rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  h1.script { line-height: 0; color: inherit; } h1.script svg { display: block; width: 100%; height: auto; }
  .hl { margin: 0; font-size: .82rem; font-weight: 500; letter-spacing: .28em; text-transform: uppercase; }
  .lead { margin: 0; font-size: 1.05rem; line-height: 1.55; }
  .cta { display: flex; flex-wrap: wrap; gap: .8rem; }
  .b1, .b2 { display: inline-flex; align-items: center; padding: .75rem 1.3rem .7rem; border-radius: 3px; font-size: .95rem; font-weight: 600; letter-spacing: .06em; text-decoration: none; transition: background-color .3s, color .3s, border-color .3s; }

  /* 1. Soft & centered: an even, gentle dim; everything centered and small; white and outline buttons. */
  .hero[data-v="1"] .shade { background: radial-gradient(ellipse at 50% 50%, rgb(18 17 15 / .58) 0, rgb(18 17 15 / .5) 45%, rgb(18 17 15 / .62) 85%); }
  .hero[data-v="1"] .content { align-items: center; justify-content: center; padding-block: 3rem; text-align: center; }
  .hero[data-v="1"] .copy { max-width: 34rem; display: grid; justify-items: center; gap: 1.2rem; }
  .hero[data-v="1"] h1.script { width: min(82vw, 25rem); }
  .hero[data-v="1"] .hl { color: rgb(255 255 255 / .82); }
  .hero[data-v="1"] .lead { color: #fff; text-shadow: 0 1px 12px rgb(0 0 0 / .5); padding-top: 1.1rem; border-top: 1px solid rgb(255 255 255 / .35); }
  .hero[data-v="1"] .b1 { background: #fff; color: var(--body-ink); }
  .hero[data-v="1"] .b1:hover { background: var(--cream); }
  .hero[data-v="1"] .b2 { border: 1px solid rgb(255 255 255 / .7); color: #fff; }
  .hero[data-v="1"] .b2:hover { background: rgb(255 255 255 / .12); }

  /* 2. Quiet corner: almost no shading; small type tucked bottom-left; text links instead of buttons. */
  .hero[data-v="2"] .shade { background: linear-gradient(to top right, rgb(18 17 15 / .7) 0, rgb(18 17 15 / .25) 40%, transparent 65%); }
  .hero[data-v="2"] .content { align-items: flex-end; padding-bottom: clamp(2.4rem, 5vw, 4rem); }
  .hero[data-v="2"] .copy { display: grid; gap: 1rem; max-width: 26rem; }
  .hero[data-v="2"] h1.script { width: min(70vw, 20rem); order: -1; }
  .hero[data-v="2"] .hl { color: rgb(255 255 255 / .75); }
  .hero[data-v="2"] .lead { color: rgb(255 255 255 / .85); font-size: 1rem; }
  .hero[data-v="2"] .b1, .hero[data-v="2"] .b2 { padding: .2rem 0; color: #fff; border-bottom: 1px solid rgb(255 255 255 / .6); border-radius: 0; margin-right: 1.2rem; }
  .hero[data-v="2"] .b1::after, .hero[data-v="2"] .b2::after { content: ' \2192'; margin-left: .35rem; }
  .hero[data-v="2"] .b1:hover, .hero[data-v="2"] .b2:hover { border-bottom-color: #fff; }

  /* 3. Cream card: the photo stays bright and untouched; the text sits on a calm cream card. */
  .hero[data-v="3"] .shade { display: none; }
  .hero[data-v="3"] .content { align-items: flex-end; padding-bottom: clamp(2rem, 4vw, 3.5rem); }
  .hero[data-v="3"] .copy { display: grid; gap: 1rem; max-width: 25rem; padding: clamp(1.6rem, 3vw, 2.4rem); background: rgb(246 241 232 / .96); color: var(--body-ink); border-radius: 6px; box-shadow: 0 20px 50px rgb(0 0 0 / .22); }
  .hero[data-v="3"] h1.script { width: min(70vw, 19rem); }
  .hero[data-v="3"] .hl { color: var(--green); }
  .hero[data-v="3"] .lead { color: var(--muted); font-size: 1rem; }
  .hero[data-v="3"] .b1 { background: var(--green); color: #fff; } .hero[data-v="3"] .b1:hover { background: var(--green-2); }
  .hero[data-v="3"] .b2 { border: 1px solid var(--body-ink); color: var(--body-ink); } .hero[data-v="3"] .b2:hover { background: var(--body-ink); color: #fff; }

  @media (max-width: 860px) {
    .hero { min-height: 78svh; }
    .photo { object-position: 62% 50%; }
    .hero[data-v="2"] .shade { background: linear-gradient(to top, rgb(18 17 15 / .8) 0, rgb(18 17 15 / .3) 45%, transparent 70%); }
    .hero[data-v="3"] .content { padding-inline: 1rem; } .hero[data-v="3"] .copy { max-width: none; }
  }

  /* ---------- shared: cream paper, thin rules ---------- */
  .statement, .chef, .dishes, .reviews, .visit, .insta { --cream: #f6f1e8; --rule: #d8cfbe; background: var(--cream); color: #2a2622; }
  section h2 { font-size: clamp(2.6rem, 5vw, 4rem); line-height: .95; }
  .label { margin: 0 0 .6rem; font-family: var(--display); font-weight: 700; font-size: 1rem; letter-spacing: .2em; text-transform: uppercase; color: var(--green); }
  .tl { color: inherit; font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; text-decoration-color: var(--green); white-space: nowrap; }
  .tl:hover { color: var(--green); }
  .sh { display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; padding-bottom: 1.1rem; margin-bottom: clamp(1.6rem, 3vw, 2.4rem); border-bottom: 1px solid var(--rule); }
  img { display: block; width: 100%; height: auto; object-fit: cover; }

  .statement { padding: clamp(40px, 6vw, 72px) 0; text-align: center; }
  .statement .container { display: flex; align-items: center; gap: 2rem; }
  .statement .container::before, .statement .container::after { content: ''; flex: 1; height: 1px; background: var(--rule); }
  .statement p { margin: 0; max-width: 40rem; font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.5; color: #4a443c; }
  .statement span { color: var(--green); font-weight: 600; }

  .chef { padding: 0 0 clamp(56px, 8vw, 96px); }
  .chef .grid { display: grid; grid-template-columns: 7fr 4fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; padding-top: clamp(28px, 4vw, 44px); border-top: 1px solid var(--rule); }
  .chef h2 { font-size: clamp(2rem, 3.4vw, 2.8rem); }
  .chef .body { margin: .7rem 0 0; font-size: 1rem; line-height: 1.6; color: #4a443c; max-width: 40rem; }
  .feats { list-style: none; margin: 1.2rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .6rem 1.8rem; }
  .feats li { display: flex; align-items: center; gap: .5rem; }
  .feats svg { width: 1.4rem; height: 1.4rem; fill: none; stroke: var(--green); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .feats b { font-family: var(--display); font-weight: 700; font-size: 1rem; letter-spacing: .06em; text-transform: uppercase; line-height: 1.1; }
  .ph { margin: 0; border-radius: 4px; overflow: hidden; }
  .ph img { aspect-ratio: 4 / 3; }

  .dishes { padding: 0 0 clamp(48px, 7vw, 80px); }
  .d3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 36px); }
  .dimg { display: block; border-radius: 4px; overflow: hidden; }
  .dimg img { aspect-ratio: 4 / 3; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .dimg:hover img { transform: scale(1.04); }
  .dr { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: 1rem; padding-bottom: .5rem; border-bottom: 1px solid var(--rule); }
  .dr h3 { font-size: 1.7rem; }
  .dr b { font-family: var(--display); font-weight: 700; font-size: 1.25rem; color: var(--green); white-space: nowrap; }
  .d3 p { margin: .6rem 0 0; font-size: .98rem; line-height: 1.55; color: #5d564c; }

  .reviews { padding: clamp(56px, 8vw, 100px) 0; border-bottom: 1px solid var(--rule); }
  .rg { display: grid; grid-template-columns: 1fr 3fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .r3 { display: grid; grid-template-columns: repeat(3, 1fr); }
  .r3 blockquote { margin: 0; padding: 0 clamp(1rem, 2.5vw, 2rem); border-left: 1px solid var(--rule); }
  .stars { color: #c99a2e; letter-spacing: .2em; font-size: .95rem; }
  .r3 p { margin: .9rem 0; font-size: 1.1rem; line-height: 1.5; color: #8a8070; font-style: italic; }
  .r3 cite { font-style: normal; font-family: var(--display); font-weight: 600; font-size: .95rem; letter-spacing: .1em; text-transform: uppercase; color: #9b9283; }

  .visit { padding: clamp(64px, 9vw, 120px) 0; }
  .hrs { font-size: 1rem; color: #5d564c; }
  .v2 { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3vw, 40px); }
  .v2 article { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; align-items: center; }
  .v2 img { aspect-ratio: 4 / 3; border-radius: 4px; height: 100%; }
  .vb h3 { font-size: 2.3rem; }
  .vb p { margin: .5rem 0 0; color: #4a443c; line-height: 1.5; }
  .tel a { color: inherit; font-weight: 600; text-decoration: none; }
  .acts { display: flex; flex-wrap: wrap; align-items: center; gap: 1.1rem; margin-top: 1.2rem; }

  .insta { padding: 0 0 clamp(64px, 9vw, 120px); }
  .ig { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }
  .ig a { display: block; overflow: hidden; border-radius: 4px; }
  .ig img { aspect-ratio: 1; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .ig a:hover img { transform: scale(1.06); }

  @media (max-width: 900px) {
    .chef .grid, .rg, .v2 { grid-template-columns: 1fr; }
    .ph { order: -1; max-width: 26rem; }
    .d3, .r3 { grid-template-columns: 1fr; }
    .r3 blockquote { border-left: 0; border-top: 1px solid var(--rule); padding: 1.2rem 0; }
    .ig { grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .statement .container::before, .statement .container::after { display: none; }
  }
  @media (max-width: 520px) { .v2 article { grid-template-columns: 1fr; } .feats { grid-template-columns: 1fr; } }
</style>
