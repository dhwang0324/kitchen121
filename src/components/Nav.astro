---
// Header: a cream bar with the logo centered and links on both sides (desktop); logo left + menu button (phones).
// Kept deliberately different from the Chicken 121 header (which floats over a dark banner).
import logo from '../assets/logo-light.webp';
import { u, LOCATIONS } from '../data/site';
interface Props { active?: string }
const { active } = Astro.props;
const left = [
  { label: 'Menu', href: u('menu/'), id: 'menu' },
  { label: 'Catering', href: u('catering/'), id: 'catering' },
];
const right = [{ label: 'Locations', href: u('locations/'), id: 'locations' }];
const rows = [{ label: 'Home', href: u(), id: 'home' }, ...left, ...right];
---
<header class="site-header" id="site-header">
  <div class="container bar">
    <nav class="side side--l" aria-label="Main">
      {left.map((l) => <a href={l.href} aria-current={active === l.id ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <a class="logo" href={u()} aria-label="Kitchen 121 home"><img src={logo.src} alt="Kitchen 121" width={logo.width} height={logo.height} /></a>
    <nav class="side side--r" aria-label="More">
      {right.map((l) => <a href={l.href} aria-current={active === l.id ? 'page' : undefined}>{l.label}</a>)}
      <a class="order" href={u('locations/')} data-order>Order Now</a>
    </nav>
    <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span><span></span></button>
  </div>
</header>

<div class="mm" id="mobile-menu" aria-hidden="true">
  <div class="scrim" data-close></div>
  <aside class="drawer" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="top">
      <img class="d-logo" src={logo.src} alt="Kitchen 121" width={logo.width} height={logo.height} />
      <button class="close" type="button" aria-label="Close menu" data-close><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg></button>
    </div>
    <nav class="rows" aria-label="Main">
      {rows.map((r) => <a class="row" href={r.href} aria-current={active === r.id ? 'page' : undefined}><span class="t">{r.label}</span><span class="ch" aria-hidden="true">&rsaquo;</span></a>)}
    </nav>
    <div class="foot">
      {LOCATIONS.map((l) => <a class="m-order" href={l.order.clover} data-order={l.id}>Order {l.short}</a>)}
      <p class="hrs">Tue to Sun 11:30am to 9pm. Monday closed.</p>
    </div>
  </aside>
</div>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--cream); border-bottom: 1px solid var(--rule); transition: box-shadow .3s; }
  .site-header.scrolled { box-shadow: 0 6px 24px rgb(0 0 0 / .06); }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1.5rem; padding-block: .85rem; }
  .logo { display: block; line-height: 0; justify-self: center; }
  .logo img { height: 2.6rem; width: auto; display: block; }
  .side { display: none; align-items: center; gap: 2rem; }
  .side--r { justify-content: flex-end; }
  .side a { color: var(--body-ink); text-decoration: none; font-size: .98rem; font-weight: 500; letter-spacing: .02em; transition: color .2s; }
  .side a:hover { color: var(--green); }
  .side a[aria-current="page"] { color: var(--green); text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; }
  .side a.order { padding: .55rem 1.1rem .5rem; border: 1px solid var(--green); border-radius: 3px; background: var(--green); color: #fff; font-weight: 600; }
  .side a.order:hover { background: var(--green-2); color: #fff; }
  .burger { justify-self: end; grid-column: 3; display: flex; flex-direction: column; gap: .36rem; padding: .5rem .2rem; background: none; border: 0; cursor: pointer; }
  .burger span { display: block; height: 2px; width: 1.5rem; background: var(--body-ink); }
  @media (max-width: 799px) { .bar { grid-template-columns: auto 1fr; } .logo { justify-self: start; grid-column: 1; grid-row: 1; } .burger { grid-column: 2; grid-row: 1; } }

  .mm { position: fixed; inset: 0; z-index: 100; visibility: hidden; transition: visibility 0s .35s; }
  .mm.open { visibility: visible; transition-delay: 0s; }
  .scrim { position: absolute; inset: 0; background: rgb(0 0 0 / .45); opacity: 0; transition: opacity .3s; }
  .mm.open .scrim { opacity: 1; }
  .drawer { position: absolute; top: 0; right: 0; bottom: 0; width: min(86vw, 21rem); display: flex; flex-direction: column; background: var(--cream); color: var(--body-ink); padding: 1.1rem 1.4rem 1.2rem; transform: translateX(104%); transition: transform .35s cubic-bezier(.2,.7,.2,1); overflow-y: auto; }
  .mm.open .drawer { transform: none; }
  .top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
  .d-logo { height: 2.3rem; width: auto; display: block; }
  .close { width: 2.6rem; height: 2.6rem; display: grid; place-items: center; border: 0; background: transparent; color: var(--body-ink); cursor: pointer; }
  .close svg { width: 1.4rem; height: 1.4rem; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; }
  .rows { display: grid; }
  .row { display: flex; align-items: center; padding: .9rem .1rem; border-bottom: 1px solid var(--rule); color: var(--body-ink); text-decoration: none; font-family: var(--head); font-size: 1.7rem; line-height: 1.1; }
  .row .ch { margin-left: auto; color: #a89f8f; font-size: 1.5rem; }
  .row[aria-current="page"], .row:hover { color: var(--green); }
  .foot { margin-top: auto; padding-top: 1.4rem; display: grid; gap: .6rem; }
  .m-order { display: flex; justify-content: center; padding: .8rem 1rem; background: var(--green); color: #fff; border-radius: 3px; text-decoration: none; font-weight: 600; letter-spacing: .03em; }
  .hrs { margin: .4rem 0 0; font-size: .82rem; color: var(--muted); text-align: center; }
  @media (prefers-reduced-motion: reduce) { .drawer, .scrim, .mm { transition: none; } }
  @media (min-width: 800px) { .side { display: flex; } .burger { display: none; } .mm { display: none !important; } }
</style>

<script>
  const header = document.getElementById('site-header');
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  if (burger && menu) {
    const closeBtn = menu.querySelector<HTMLButtonElement>('.close');
    const set = (open: boolean) => {
      menu.classList.toggle('open', open);
      menu.setAttribute('aria-hidden', String(!open));
      burger.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) closeBtn?.focus(); else burger.focus({ preventScroll: true });
    };
    burger.addEventListener('click', () => set(true));
    menu.addEventListener('click', (e) => { const el = e.target as HTMLElement; if (el.closest('[data-close]') || el.closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.classList.contains('open')) set(false); });
    window.matchMedia('(min-width: 800px)').addEventListener('change', (m) => { if (m.matches && menu.classList.contains('open')) set(false); });
  }
</script>
